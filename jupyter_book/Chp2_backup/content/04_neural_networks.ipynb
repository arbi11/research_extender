    "## Individual Neuron Operation\n",
    "\n",
    "Each neuron in a neural network performs a specific computation:\n",
    "\n",
    "### Mathematical Operation:\n",
    "For a neuron receiving inputs $x_1, x_2, ..., x_n$ with weights $w_1, w_2, ..., w_n$ and bias $b$:\n",
    "\n",
    "$$\\text{weighted\\_sum} = w_1 x_1 + w_2 x_2 + ... + w_n x_n + b$$\n",
    "\n",
    "$$\\text{output} = f(\\text{weighted\\_sum})$$\n",
    "\n",
    "where $f$ is the activation function."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Neuron:\n",
    "    \"\"\"Single neuron implementation for demonstration.\"\"\"\n",
    "    \n",
    "    def __init__(self, n_inputs):\n",
    "        # Initialize weights randomly (small values)\n",
    "        self.weights = np.random.randn(n_inputs) * 0.1\n",
    "        self.bias = np.random.randn() * 0.1\n",
    "        self.n_inputs = n_inputs\n",
    "    \n",
    "    def forward(self, inputs):\n",
    "        \"\"\"Forward pass through the neuron.\"\"\"\n",
    "        if len(inputs) != self.n_inputs:\n",
    "            raise ValueError(f\"Expected {self.n_inputs} inputs, got {len(inputs)}\")\n",
    "        \n",
    "        # Calculate weighted sum\n",
    "        weighted_sum = np.dot(self.weights, inputs) + self.bias\n",
    "        \n",
    "        # Apply activation function (ReLU by default)\n",
    "        output = self.relu(weighted_sum)\n",
    "        \n",
    "        return output, weighted_sum\n",
    "    \n",
    "    def relu(self, x):\n",
    "        \"\"\"ReLU activation function.\"\"\"\n",
    "        return max(0, x)\n",
    "    \n",
    "    def sigmoid(self, x):\n",
    "        \"\"\"Sigmoid activation function.\"\"\"\n",
    "        return 1 / (1 + np.exp(-x))\n",
    "    \n",
    "    def tanh(self, x):\n",
    "        \"\"\"Tanh activation function.\"\"\"\n",
    "        return np.tanh(x)\n",
    "\n",
    "# Demonstrate individual neuron operation\n",
    "print(\"Single Neuron Demonstration:\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "# Create a neuron with 3 inputs\n",
    "neuron = Neuron(n_inputs=3)\n",
    "\n",
    "# Show initial weights and bias\n",
    "print(f\"Initial weights: {neuron.weights.round(4)}\")\n",
    "print(f\"Initial bias: {neuron.bias.round(4)}\")\n",
    "\n",
    "# Test with different inputs\n",
    "test_inputs = [\n",
    "    [0.1, 0.2, 0.3],  # Small positive inputs\n",
    "    [1.0, 1.0, 1.0],  # Larger positive inputs\n",
    "    [-0.5, -0.3, 0.2], # Mixed positive/negative\n",
    "    [0.0, 0.0, 0.0]    # Zero inputs\n",
    "]\n",
    "\n",
    "print(\"\\nTesting with different inputs:\")\n",
    "for i, inputs in enumerate(test_inputs):\n",
    "    output, weighted_sum = neuron.forward(inputs)\n",
    "    print(f\"Input {i+1}: {inputs}\")\n",
    "    print(f\"  Weighted sum: {weighted_sum:.4f}\")\n",
    "    print(f\"  ReLU output: {output:.4f}\")\n",
    "    print()"
   ]
  },
