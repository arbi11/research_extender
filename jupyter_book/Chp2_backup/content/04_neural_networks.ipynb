    "## Activation Functions\n",
    "\n",
    "Activation functions introduce non-linearity into neural networks, allowing them to learn complex patterns. Different activation functions have different properties and use cases."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demonstrate different activation functions\n",
    "def relu(x):\n",
    "    return np.maximum(0, x)\n",
    "\n",
    "def sigmoid(x):\n",
    "    return 1 / (1 + np.exp(-x))\n",
    "\n",
    "def tanh(x):\n",
    "    return np.tanh(x)\n",
    "\n",
    "def leaky_relu(x, alpha=0.01):\n",
    "    return np.where(x > 0, x, alpha * x)\n",
    "\n",
    "def elu(x, alpha=1.0):\n",
    "    return np.where(x > 0, x, alpha * (np.exp(x) - 1))\n",
    "\n",
    "# Create input range\n",
    "x = np.linspace(-5, 5, 1000)\n",
    "\n",
    "# Calculate activation functions\n",
    "activations = {\n",
    "    'ReLU': relu(x),\n",
    "    'Sigmoid': sigmoid(x),\n",
    "    'Tanh': tanh(x),\n",
    "    'Leaky ReLU': leaky_relu(x),\n",
    "    'ELU': elu(x)\n",
    "}\n",
    "\n",
    "# Create comparison plot\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "fig.suptitle('Activation Functions Comparison', fontsize=16, fontweight='bold')\n",
    "\n",
    "# Plot each activation function\n",
    "for idx, (name, y) in enumerate(activations.items()):\n",
    "    ax = axes[idx // 3, idx % 3]\n",
    "    ax.plot(x, y, linewidth=2.5, color=f'C{idx}')\n",
    "    ax.set_title(name, fontsize=12, fontweight='bold')\n",
    "    ax.set_xlabel('Input')\n",
    "    ax.set_ylabel('Output')\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    ax.axhline(y=0, color='k', linestyle='-', alpha=0.3)\n",
    "    ax.axvline(x=0, color='k', linestyle='-', alpha=0.3)\n",
    "    \n",
    "    # Add annotations\n",
    "    if name == 'ReLU':\n",
    "        ax.text(-3, 2, 'No negative\\noutputs', fontsize=9, ha='center',\n",
    "               bbox=dict(boxstyle='round', facecolor='yellow', alpha=0.5))\n",
    "    elif name == 'Sigmoid':\n",
    "        ax.text(0, 0.8, '(0, 0.5)', fontsize=9, ha='center',\n",
    "               bbox=dict(boxstyle='round', facecolor='yellow', alpha=0.5))\n",
    "        ax.text(0, -0.2, 'Range: [0, 1]', fontsize=9, ha='center',\n",
    "               bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.5))\n",
    "    elif name == 'Tanh':\n",
    "        ax.text(0, 0.8, '(0, 0)', fontsize=9, ha='center',\n",
    "               bbox=dict(boxstyle='round', facecolor='yellow', alpha=0.5))\n",
    "        ax.text(0, -0.8, 'Range: [-1, 1]', fontsize=9, ha='center',\n",
    "               bbox=dict(boxstyle='round', facecolor='lightblue', alpha=0.5))\n",
    "\n",
    "# Remove empty subplot\n",
    "axes[1, 2].remove()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"Activation Function Properties:\")\n",
    "print(\"=\" * 40)\n",
    "print(\"ReLU: Simple, fast, no negative outputs\")\n",
    "print(\"Sigmoid: Smooth, bounded [0,1], can cause vanishing gradients\")\n",
    "print(\"Tanh: Smooth, bounded [-1,1], zero-centered\")\n",
    "print(\"Leaky ReLU: Solves dying ReLU problem\")\n",
    "print(\"ELU: Smooth for negative values, can cause exploding activations\")\n",
    "print(\"\\nFor magnetic field prediction: ReLU and Leaky ReLU are commonly used\")"
