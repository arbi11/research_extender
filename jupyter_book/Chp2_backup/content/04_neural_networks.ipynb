   "source": [
    "## Loss Functions\n",
    "\n",
    "Loss functions measure the quality of model predictions by comparing them to ground truth targets. For regression tasks like magnetic field prediction, common loss functions include:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def mean_squared_error(y_true, y_pred):\n",
    "    \"\"\"Mean Squared Error (MSE) loss function.\"\"\"\n",
    "    return np.mean((y_true - y_pred) ** 2)\n",
    "\n",
    "def mean_absolute_error(y_true, y_pred):\n",
    "    \"\"\"Mean Absolute Error (MAE) loss function.\"\"\"\n",
    "    return np.mean(np.abs(y_true - y_pred))\n",
    "\n",
    "def huber_loss(y_true, y_pred, delta=1.0):\n",
    "    \"\"\"Huber loss - combination of MSE and MAE.\"\"\"\n",
    "    error = y_true - y_pred\n",
    "    abs_error = np.abs(error)\n",
    "    \n",
    "    # Quadratic for small errors, linear for large errors\n",
    "    loss = np.where(abs_error <= delta, \n",
    "                    0.5 * error ** 2,\n",
    "                    delta * (abs_error - 0.5 * delta))\n",
    "    \n",
    "    return np.mean(loss)\n",
    "\n",
    "# Create sample predictions and targets\n",
    "np.random.seed(42)\n",
    "n_samples = 100\n",
    "y_true = np.random.randn(n_samples)\n",
    "\n",
    "# Create predictions with different noise levels\n",
    "predictions = {\n",
    "    'Good': y_true + np.random.randn(n_samples) * 0.1,\n",
    "    'Medium': y_true + np.random.randn(n_samples) * 0.5,\n",
    "    'Poor': y_true + np.random.randn(n_samples) * 1.5\n",
    "}\n",
    "\n",
    "# Calculate losses\n",
    "print(\"Loss Function Comparison:\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "for name, y_pred in predictions.items():\n",
    "    mse = mean_squared_error(y_true, y_pred)\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    huber = huber_loss(y_true, y_pred)\n",
    "    \n",
    "    print(f\"{name} Prediction:\")\n",
    "    print(f\"  MSE:  {mse:.4f}\")\n",
    "    print(f\"  MAE:  {mae:.4f}\")\n",
    "    print(f\"  Huber: {huber:.4f}\")\n",
    "    print()\n",
    "\n",
    "# Visualize loss landscapes\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "fig.suptitle('Loss Functions Visualization', fontsize=14, fontweight='bold')\n",
    "\n",
    "# Create error range\n",
    "errors = np.linspace(-3, 3, 1000)\n",
    "\n",
    "# Plot individual loss functions\n",
    "loss_functions = [\n",
    "    ('Mean Squared Error', errors ** 2, axes[0]),\n",
    "    ('Mean Absolute Error', np.abs(errors), axes[1]),\n",
    "    ('Huber Loss', np.where(np.abs(errors) <= 1, 0.5 * errors ** 2, np.abs(errors) - 0.5), axes[2])\n",
    "]\n",
    "\n",
    "for name, loss_values, ax in loss_functions:\n",
    "    ax.plot(errors, loss_values, linewidth=2.5, color='blue')\n",
    "    ax.set_title(name, fontsize=12, fontweight='bold')\n",
    "    ax.set_xlabel('Error (y_true - y_pred)')\n",
    "    ax.set_ylabel('Loss')\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    ax.axhline(y=0, color='k', linestyle='-', alpha=0.3)\n",
    "    ax.axvline(x=0, color='k', linestyle='-', alpha=0.3)\n",
    "    \n",
    "    # Highlight optimal point\n",
    "    ax.plot(0, 0, 'ro', markersize=8, label='Optimal (error = 0)')\n",
    "    ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"For magnetic field prediction:\")\n",
    "print(\"- MSE is most commonly used\")\n",
    "print(\"- It heavily penalizes large errors\")\n",
    "print(\"- Differentiable everywhere, good for gradient-based optimization\")"
   ]
