    "## Simple Neural Network Implementation\n",
    "\n",
    "Let's implement a simple neural network for magnetic field prediction using the concepts we've learned."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class SimpleNeuralNetwork:\n",
    "    \"\"\"Simple feedforward neural network for demonstration.\"\"\"\n",
    "    \n",
    "    def __init__(self, layer_sizes):\n",
    "        \"\"\"Initialize network with given layer sizes.\n",
    "        \n",
    "        Args:\n",
    "            layer_sizes: List of integers [input_size, hidden1_size, ..., output_size]\n",
    "        \"\"\"\n",
    "        self.layer_sizes = layer_sizes\n",
    "        self.n_layers = len(layer_sizes)\n",
    "        \n",
    "        # Initialize weights and biases\n",
    "        self.weights = []\n",
    "        self.biases = []\n",
    "        \n",
    "        for i in range(self.n_layers - 1):\n",
    "            # Xavier initialization for better training\n",
    "            n_in = layer_sizes[i]\n",
    "            n_out = layer_sizes[i + 1]\n",
    "            \n",
    "            limit = np.sqrt(6 / (n_in + n_out))\n",
    "            weights = np.random.uniform(-limit, limit, (n_out, n_in))\n",
    "            bias = np.zeros((n_out,))\n",
    "            \n",
    "            self.weights.append(weights)\n",
    "            self.biases.append(bias)\n",
    "    \n",
    "    def forward(self, X):\n",
    "        \"\"\"Forward pass through the network.\"\"\"\n",
    "        activations = [X]\n",
    "        z_values = []\n",
    "        \n",
    "        # Forward through hidden layers (with ReLU)\n",
    "        for i in range(len(self.weights) - 1):\n",
    "            z = np.dot(activations[-1], self.weights[i].T) + self.biases[i]\n",
    "            z_values.append(z)\n",
    "            a = self.relu(z)\n",
    "            activations.append(a)\n",
    "        \n",
    "        # Forward through output layer (no activation for regression)\n",
    "        z = np.dot(activations[-1], self.weights[-1].T) + self.biases[-1]\n",
    "        z_values.append(z)\n",
    "        activations.append(z)  # No activation for output layer\n",
    "        \n",
    "        return activations[-1], activations, z_values\n",
    "    \n",
    "    def relu(self, x):\n",
    "        \"\"\"ReLU activation function with numpy support.\"\"\"\n",
    "        return np.maximum(0, x)\n",
    "    \n",
    "    def relu_derivative(self, x):\n",
    "        \"\"\"Derivative of ReLU function.\"\"\"\n",
    "        return (x > 0).astype(float)\n",
    "    \n",
    "    def compute_loss(self, y_true, y_pred):\n",
    "        \"\"\"Compute mean squared error loss.\"\"\"\n",
    "        return np.mean((y_true - y_pred) ** 2)\n",
    "    \n",
    "    def backward(self, X, y_true, activations, z_values, learning_rate=0.01):\n",
    "        \"\"\"Simple backward pass for demonstration (simplified).\"\"\"\n",
    "        n_samples = X.shape[0]\n",
    "        \n",
    "        # Output layer gradients\n",
    "        delta = activations[-1] - y_true  # dL/dz for output layer\n",
    "        \n",
    "        # Update output layer weights and biases\n",
    "        self.weights[-1] -= learning_rate * np.dot(delta.T, activations[-2]) / n_samples\n",
    "        self.biases[-1] -= learning_rate * np.mean(delta, axis=0)\n",
    "        \n",
    "        # Backpropagate through hidden layers\n",
    "        for i in range(len(self.weights) - 2, -1, -1):\n",
    "            delta = np.dot(delta, self.weights[i + 1]) * self.relu_derivative(z_values[i])\n",
    "            \n",
    "            self.weights[i] -= learning_rate * np.dot(delta.T, activations[i]) / n_samples\n",
    "            self.biases[i] -= learning_rate * np.mean(delta, axis=0)\n",
    "    \n",
    "    def train_step(self, X, y_true, learning_rate=0.01):\n",
    "        \"\"\"Single training step (forward + backward).\"\"\"\n",
    "        # Forward pass\n",
    "        y_pred, activations, z_values = self.forward(X)\n",
    "        \n",
    "        # Compute loss\n",
    "        loss = self.compute_loss(y_true, y_pred)\n",
    "        \n",
    "        # Backward pass\n",
    "        self.backward(X, y_true, activations, z_values, learning_rate)\n",
    "        \n",
    "        return loss\n",
    "\n",
    "# Create sample training data for demonstration\n",
    "print(\"Creating sample training data...\")\n",
    "np.random.seed(42)\n",
    "\n",
    "# Generate synthetic magnetic field data\n",
    "n_samples = 100\n",
    "n_features = 3  # geometry, material, excitation\n",
    "n_outputs = 1  # magnetic field magnitude\n",
    "\n",
    "# Generate input features\n",
    "X_train = np.random.randn(n_samples, n_features)\n",
    "\n",
