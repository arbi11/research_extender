    "# Generate large set of design concepts\n",
    "def generate_concept_library(num_concepts=10000):\n",
    "    \"\"\"Generate diverse library of motor design concepts\"\"\"\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    # Design parameters for concepts\n",
    "    concepts = {\n",
    "        'air_gap': np.random.uniform(0.5, 2.0, num_concepts),\n",
    "        'magnet_thickness': np.random.uniform(2.0, 6.0, num_concepts),\n",
    "        'magnet_width': np.random.uniform(5.0, 15.0, num_concepts),\n",
    "        'num_slots': np.random.choice([12, 15, 18, 21, 24, 27, 30, 33, 36], num_concepts),\n",
    "        'tooth_width': np.random.uniform(2.0, 6.0, num_concepts),\n",
    "        'back_iron': np.random.uniform(3.0, 8.0, num_concepts),\n",
    "    }\n",
    "    \n",
    "    # Performance predictions for all concepts\n",
    "    performances = []\n",
    "    for i in range(num_concepts):\n",
    "        perf = predict_performance(\n",
    "            concepts['air_gap'][i],\n",
    "            concepts['magnet_thickness'][i],\n",
    "            concepts['magnet_width'][i],\n",
    "            concepts['num_slots'][i]\n",
    "        )\n",
    "        performances.append(perf)\n",
    "    \n",
    "    # Convert to arrays\n",
    "    efficiencies = np.array([p['efficiency'] for p in performances])\n",
    "    torques = np.array([p['torque'] for p in performances])\n",
    "    power_factors = np.array([p['power_factor'] for p in performances])\n",
    "    \n",
    "    return concepts, efficiencies, torques, power_factors\n",
    "\n",
    "# Generate concept library\n",
    "concepts, efficiencies, torques, power_factors = generate_concept_library(10000)\n",
    "\n",
    "print(\"=== Early-Stage Design Screening ===\")\n",
    "print(f\"Generated {len(efficiencies):,} design concepts\")\n",
    "print(f\"Screening completed in {10000 * 0.02/1000:.1f} seconds (ML-based)\")\n",
    "print(f\"Traditional FEA approach would take {10000 * 2:.0f} hours\")\n",
    "print(f\"Speedup: {10000 * 2 / (10000 * 0.02/3600):,.0f}×\")\n",
    "\n",
    "# Screening criteria\n",
    "def screen_designs(efficiencies, torques, power_factors, \n",
    "                 min_efficiency=88, min_torque=60, min_pf=0.85):\n",
    "    \"\"\"Apply design screening criteria\"\"\"\n",
    "    mask = (efficiencies >= min_efficiency) & \\\n",
    "           (torques >= min_torque) & \\\n",
    "           (power_factors >= min_pf)\n",
    "    \n",
    "    return mask\n",
    "\n",
    "# Apply screening\n",
    "screen_mask = screen_designs(efficiencies, torques, power_factors)\n",
    "screened_count = np.sum(screen_mask)\n",
    "screen_percentage = screened_count / len(efficiencies) * 100\n",
    "\n",
    "print(f\"\\n=== Screening Results ===\")\n",
    "print(f\"Screening criteria:\")\n",
    "print(f\"  - Minimum efficiency: 88%\")\n",
    "print(f\"  - Minimum torque: 60 Nm\")\n",
    "print(f\"  - Minimum power factor: 0.85\")\n",
    "print(f\"\\nConcepts passing all criteria: {screened_count:,} ({screen_percentage:.1f}%)\")\n",
    "print(f\"Concepts rejected: {len(efficiencies) - screened_count:,} ({100-screen_percentage:.1f}%)\")\n",
    "\n",
    "# Select top designs for detailed analysis\n",
    "def calculate_performance_score(eff, torque, pf):\n",
    "    \"\"\"Calculate overall performance score\"\"\"\n",
