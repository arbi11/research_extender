    "---\n",
    "\n",
    "## 2. Interactive Design Exploration\n",
    "\n",
    "### Real-time Feedback as Designers Adjust Parameters\n",
    "\n",
    "Machine learning enables fundamentally new design workflows where engineers can explore design spaces interactively:\n",
    "\n",
    "**Traditional Workflow:**\n",
    "- Adjust design parameters\n",
    "- Wait 1-2 hours for FEA simulation\n",
    "- Review results\n",
    "- Make another adjustment\n",
    "- Repeat (limited to 5-10 iterations per day)\n",
    "\n",
    "**ML-Enabled Workflow:**\n",
    "- Adjust design parameters\n",
    "- Get instant results (20 milliseconds)\n",
    "- Explore multiple variations simultaneously\n",
    "- Build intuition through rapid feedback\n",
    "- Thousands of iterations per hour"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Interactive Design Exploration Simulation\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output\n",
    "import time\n",
    "\n",
    "# Simulate a simple motor performance predictor\n",
    "def predict_performance(air_gap, magnet_thickness, magnet_width, num_slots):\n",
    "    \"\"\"Simplified performance prediction function\"\"\"\n",
    "    # Efficiency model\n",
    "    efficiency = 88 + 3 * np.exp(-((air_gap - 1.0)**2) / 0.3) + \\\n",
    "                 1.5 * np.exp(-((magnet_thickness - 4.0)**2) / 1.5) - \\\n",
    "                 0.5 * np.abs(magnet_width - 10) / 10\n",
    "    \n",
    "    # Torque model\n",
    "    torque = 0.8 * num_slots * magnet_thickness * magnet_width / 100\n",
    "    \n",
    "    # Power factor model\n",
    "    power_factor = 0.85 + 0.08 * np.sin(num_slots * np.pi / 12) - 0.03 * air_gap\n",
    "    \n",
    "    return {\n",
    "        'efficiency': np.clip(efficiency, 75, 95),\n",
    "        'torque': np.clip(torque, 20, 120),\n",
    "        'power_factor': np.clip(power_factor, 0.7, 0.95)\n",
    "    }\n",
    "\n",
    "print(\"=== Interactive Design Exploration ===\")\n",
    "print(\"Simulating real-time design parameter adjustment...\")\n",
    "print(\"\\nDesign Parameters:\")\n",
    "print(\"- Air gap: 0.5-2.0 mm\")\n",
    "print(\"- Magnet thickness: 2.0-6.0 mm\")\n",
    "print(\"- Magnet width: 5.0-15.0 mm\")\n",
    "print(\"- Number of slots: 12-36\")\n",
    "\n",
    "# Simulate interactive parameter exploration\n",
    "print(\"\\n=== Simulated Design Session ===\")\n",
    "print(\"(Demonstrating what would be possible with real-time interface)\")\n",
    "\n",
    "# Design scenarios to explore\n",
    "design_scenarios = [\n",
    "    {'air_gap': 1.0, 'magnet_thickness': 4.0, 'magnet_width': 10.0, 'num_slots': 24, 'description': 'Baseline design'},\n",
    "    {'air_gap': 0.8, 'magnet_thickness': 4.5, 'magnet_width': 10.0, 'num_slots': 24, 'description': 'Reduced air gap'},\n",
    "    {'air_gap': 1.0, 'magnet_thickness': 5.0, 'magnet_width': 12.0, 'num_slots': 24, 'description': 'Increased magnet size'},\n",
    "    {'air_gap': 1.2, 'magnet_thickness': 4.0, 'magnet_width': 10.0, 'num_slots': 30, 'description': 'More slots, larger air gap'},\n",
    "    {'air_gap': 0.7, 'magnet_thickness': 5.5, 'magnet_width': 11.0, 'num_slots': 27, 'description': 'Optimized configuration'},\n",
    "]\n",
    "\n",
    "for i, scenario in enumerate(design_scenarios, 1):\n",
    "    print(f\"\\nDesign {i}: {scenario['description']}\")\n",
    "    print(f\"  Parameters: Air Gap={scenario['air_gap']:.1f}mm, \"\n",
    "          f\"Mag Thickness={scenario['magnet_thickness']:.1f}mm, \"\n",
    "          f\"Mag Width={scenario['magnet_width']:.1f}mm, \"\n",
    "          f\"Slots={int(scenario['num_slots'])}\")\n",
    "    \n",
    "    # Simulate \"instant\" prediction\n",
    "    start_time = time.time()\n",
    "    performance = predict_performance(\n",
    "        scenario['air_gap'], \n",
    "        scenario['magnet_thickness'], \n",
    "        scenario['magnet_width'], \n",
    "        scenario['num_slots']\n",
    "    )\n",
    "    prediction_time = (time.time() - start_time) * 1000  # Convert to milliseconds\n",
    "    \n",
    "    print(f\"  Predicted Performance (in {prediction_time:.1f}ms):\")\n",
    "    print(f\"    Efficiency: {performance['efficiency']:.1f}%\")\n",
    "    print(f\"    Torque: {performance['torque']:.1f} Nm\")\n",
    "    print(f\"    Power Factor: {performance['power_factor']:.3f}\")\n",
    "    \n",
    "    # Performance rating\n",
    "    score = (performance['efficiency'] - 85) * 2 + performance['torque'] / 10 + (performance['power_factor'] - 0.8) * 50\n",
    "    print(f\"    Overall Score: {score:.1f}/100\")\n",
    "\n",
    "# Compare with FEA timing\n",
    "print(\"\\n=== Timing Comparison ===\")\n",
    "print(\"Traditional FEA approach:\")\n",
    "print(f\"  Time per evaluation: {fea_time_hours * 60:.0f} minutes\")\n",
    "print(f\"  Total time for 5 designs: {5 * fea_time_hours:.1f} hours\")\n",
    "print(f\"  Designs per day: {24 / fea_time_hours:.0f}\")\n",
    "print()\n",
    "print(\"ML surrogate approach:\")\n",
    "print(f\"  Time per evaluation: {prediction_time:.1f} milliseconds\")\n",
    "print(f\"  Total time for 5 designs: {5 * prediction_time / 1000:.1f} seconds\")\n",
    "print(f\"  Designs per second: {1000 / prediction_time:.0f}\")\n",
    "print(f\"  Designs per hour: {3600 * 1000 / prediction_time:,.0f}\")\n",
    "\n",
    "# Design space visualization\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "fig.suptitle('Interactive Design Space Exploration', fontsize=16)\n",
    "\n",
    "# Create parameter grid for visualization\n",
    "param_ranges = {\n",
    "    'air_gap': np.linspace(0.5, 2.0, 50),\n",
    "    'magnet_thickness': np.linspace(2.0, 6.0, 50),\n",
    "    'magnet_width': np.linspace(5.0, 15.0, 50),\n",
    "    'num_slots': np.arange(12, 37, 3)\n",
    "}\n",
    "\n",
    "# Plot 1: Air gap vs magnet thickness\n",
    "ax = axes[0, 0]\n",
    "AG_grid, MT_grid = np.meshgrid(param_ranges['air_gap'], param_ranges['magnet_thickness'])\n",
    "efficiency_grid = np.zeros_like(AG_grid)\n",
    "for i in range(len(param_ranges['air_gap'])):\n",
    "    for j in range(len(param_ranges['magnet_thickness'])):\n",
    "        perf = predict_performance(AG_grid[j,i], MT_grid[j,i], 10.0, 24)\n",
    "        efficiency_grid[j,i] = perf['efficiency']\n",
    "\n",
    "contour1 = ax.contourf(AG_grid, MT_grid, efficiency_grid, levels=20, cmap='viridis')\n",
    "ax.set_xlabel('Air Gap (mm)')\n",
    "ax.set_ylabel('Magnet Thickness (mm)')\n",
    "ax.set_title('Efficiency Contours')\n",
    "plt.colorbar(contour1, ax=ax, label='Efficiency (%)')\n",
    "\n",
    "# Plot 2: Number of slots vs magnet width\n",
    "ax = axes[0, 1]\n",
    "MS_grid, NS_grid = np.meshgrid(param_ranges['magnet_width'], param_ranges['num_slots'])\n",
    "torque_grid = np.zeros_like(MS_grid)\n",
    "for i in range(len(param_ranges['magnet_width'])):\n",
    "    for j in range(len(param_ranges['num_slots'])):\n",
    "        perf = predict_performance(1.0, 4.0, MS_grid[j,i], NS_grid[j,i])\n",
    "        torque_grid[j,i] = perf['torque']\n",
    "\n",
    "contour2 = ax.contourf(MS_grid, NS_grid, torque_grid, levels=20, cmap='plasma')\n",
    "ax.set_xlabel('Magnet Width (mm)')\n",
    "ax.set_ylabel('Number of Slots')\n",
    "ax.set_title('Torque Contours')\n",
    "plt.colorbar(contour2, ax=ax, label='Torque (Nm)')\n",
    "\n",
    "# Plot 3: Multi-objective trade-off\n",
    "ax = axes[1, 0]\n",
    "sampled_designs = []\n",
    "for _ in range(1000):\n",
    "    design = {\n",
    "        'air_gap': np.random.uniform(0.5, 2.0),\n",
    "        'magnet_thickness': np.random.uniform(2.0, 6.0),\n",
    "        'magnet_width': np.random.uniform(5.0, 15.0),\n",
    "        'num_slots': np.random.choice(param_ranges['num_slots'])\n",
    "    }\n",
    "    perf = predict_performance(**design)\n",
    "    sampled_designs.append(perf)\n",
    "\n",
    "efficiencies = [d['efficiency'] for d in sampled_designs]\n",
    "torques = [d['torque'] for d in sampled_designs]\n",
    "power_factors = [d['power_factor'] for d in sampled_designs]\n",
    "\n",
    "scatter = ax.scatter(efficiencies, torques, c=power_factors, cmap='coolwarm', alpha=0.6, s=30)\n",
    "ax.set_xlabel('Efficiency (%)')\n",
    "ax.set_ylabel('Torque (Nm)')\n",
    "ax.set_title('Multi-Objective Trade-off')\n",
    "plt.colorbar(scatter, ax=ax, label='Power Factor')\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 4: Design evolution timeline\n",
    "ax = axes[1, 1]\n",
    "timeline_scores = []\n",
    "for i, scenario in enumerate(design_scenarios):\n",
    "    perf = predict_performance(**scenario)\n",
    "    score = (perf['efficiency'] - 85) * 2 + perf['torque'] / 10 + (perf['power_factor'] - 0.8) * 50\n",
