   "source": [
    "# Optimization Algorithm Comparison\n",
    "algorithms = [\n",
    "    {\n",
    "        'name': 'Genetic Algorithm',\n",
    "        'population': 1000,\n",
    "        'generations': 5000,\n",
    "        'evaluations': lambda p, g: p * g\n",
    "    },\n",
    "    {\n",
    "        'name': 'Particle Swarm',\n",
    "        'population': 500,\n",
    "        'generations': 10000,\n",
    "        'evaluations': lambda p, g: p * g\n",
    "    },\n",
    "    {\n",
    "        'name': 'Simulated Annealing',\n",
    "        'population': 1,\n",
    "        'generations': 1000000,\n",
    "        'evaluations': lambda p, g: p * g\n",
    "    },\n",
    "    {\n",
    "        'name': 'Bayesian Optimization',\n",
    "        'population': 1,\n",
    "        'generations': 50000,\n",
    "        'evaluations': lambda p, g: p * g\n",
    "    }\n",
    "]\n",
    "\n",
    "print(\"=== Optimization Algorithms with ML Surrogates ===\")\n",
    "print(\"Algorithm          | Population | Generations | Total Evaluations | Time (ML) | Time (FEA)\")\n",
    "print(\"-\" * 90)\n",
    "\n",
    "for alg in algorithms:\n",
    "    total_evals = alg['evaluations'](alg['population'], alg['generations'])\n",
    "    ml_time = total_evals * ml_time_seconds / 3600  # hours\n",
    "    fea_time = total_evals * fea_time_hours  # hours\n",
    "    \n",
    "    print(f\"{alg['name']:<18} | {alg['population']:>9} | {alg['generations']:>11} | {total_evals:>15,} | {ml_time:>8.1f}h | {fea_time:>8.0f}h\")\n",
    "\n",
    "# Visualize optimization landscape exploration\n",
    "fig, ax = plt.subplots(figsize=(12, 8))\n",
    "\n",
    "# Create a simple 2D optimization landscape\n",
    "x = np.linspace(-5, 5, 100)\n",
    "y = np.linspace(-5, 5, 100)\n",
    "X, Y = np.meshgrid(x, y)\n",
    "\n",
    "# Multi-modal function (simplified electromagnetic performance)\n",
    "Z = (np.sin(X) * np.cos(Y) + \n",
    "     0.5 * np.sin(2*X) * np.cos(2*Y) + \n",
    "     0.3 * np.exp(-((X-2)**2 + (Y-2)**2)/2) +\n",
    "     0.3 * np.exp(-((X+2)**2 + (Y+2)**2)/2))\n",
    "\n",
    "# Plot landscape\n",
    "contour = ax.contourf(X, Y, Z, levels=20, cmap='viridis', alpha=0.6)\n",
    "ax.contour(X, Y, Z, levels=20, colors='black', alpha=0.2, linewidths=0.5)\n",
    "plt.colorbar(contour, ax=ax, label='Performance')\n",
    "\n",
    "# Simulate optimization paths\n",
    "np.random.seed(42)\n",
    "\n",
    "# Limited exploration (FEA-based)\n",
    "limited_points = 50\n",
    "limited_x = np.random.uniform(-5, 5, limited_points)\n",
    "limited_y = np.random.uniform(-5, 5, limited_points)\n",
    "ax.scatter(limited_x, limited_y, c='red', s=50, alpha=0.7, \n",
    "           label=f'FEA-based ({limited_points} points)', marker='o', edgecolors='black')\n",
    "\n",
    "# Comprehensive exploration (ML-based)\n",
    "comprehensive_points = 1000\n",
    "comprehensive_x = np.random.uniform(-5, 5, comprehensive_points)\n",
    "comprehensive_y = np.random.uniform(-5, 5, comprehensive_points)\n",
    "ax.scatter(comprehensive_x, comprehensive_y, c='white', s=10, alpha=0.4,\n",
    "           label=f'ML-based ({comprehensive_points} points)', marker='.')\n",
    "\n",
    "# Find and mark optimal points\n",
    "from scipy.interpolate import griddata\n",
    "limited_z = griddata((limited_x, limited_y), \n",
    "                    np.sin(limited_x) * np.cos(limited_y) + \n",
    "                    0.5 * np.sin(2*limited_x) * np.cos(2*limited_y),\n",
    "                    (limited_x, limited_y), method='linear', fill_value=0)\n",
    "\n",
    "comprehensive_z = griddata((comprehensive_x, comprehensive_y),\n",
    "                          np.sin(comprehensive_x) * np.cos(comprehensive_y) +\n",
    "                          0.5 * np.sin(2*comprehensive_x) * np.cos(2*comprehensive_y),\n",
    "                          (comprehensive_x, comprehensive_y), method='linear', fill_value=0)\n",
    "\n",
    "# Mark best found points\n",
    "limited_best_idx = np.nanargmax(limited_z)\n",
    "comprehensive_best_idx = np.nanargmax(comprehensive_z)\n",
    "\n",
    "ax.scatter(limited_x[limited_best_idx], limited_y[limited_best_idx], \n",
    "           c='red', s=200, marker='*', edgecolors='yellow', linewidth=2,\n",
    "           label='FEA best found', zorder=5)\n",
    "ax.scatter(comprehensive_x[comprehensive_best_idx], comprehensive_y[comprehensive_best_idx],\n",
    "           c='yellow', s=200, marker='*', edgecolors='red', linewidth=2,\n",
    "           label='ML best found', zorder=5)\n",
    "\n",
    "ax.set_xlabel('Design Parameter 1')\n",
    "ax.set_ylabel('Design Parameter 2')\n",
    "ax.set_title('Design Space Exploration: FEA vs ML Approach')\n",
    "ax.legend(loc='upper right', bbox_to_anchor=(1.15, 1))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n=== Key Insight ===\")\n",
    "print(\"Limited exploration (FEA) often misses global optima\")\n",
    "print(\"Comprehensive exploration (ML) finds better solutions\")\n",
    "print(\"The speedup enables finding truly optimal designs\")"
   ]
