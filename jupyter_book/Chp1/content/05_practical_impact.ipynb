    "## 1. Accelerated Design Optimization\n",
    "\n",
    "### Before: Genetic Algorithm with FEA Evaluations\n",
    "\n",
    "Traditional design optimization using genetic algorithms faces severe computational limitations:\n",
    "\n",
    "**Computational Requirements:**\n",
    "- **1000 generations** × **100 population** = **100,000 FEA calls**\n",
    "- **100,000 hours** ≈ **11.4 years of computation**\n",
    "- **Multiple design variables** requiring parallel evaluation\n",
    "- **Constrained by available computational resources**\n",
    "\n",
    "### After: Genetic Algorithm with CNN Surrogate\n",
    "\n",
    "Machine learning surrogates revolutionize the optimization landscape:\n",
    "\n",
    "**Dramatic Speedup:**\n",
    "- **100,000 predictions** × **0.02 seconds** = **33 minutes**\n",
    "- **11.4 years → 33 minutes** (speedup factor: 19,000×)\n",
    "- **Same optimization quality** with massive time savings\n",
    "- **Enables real-time design exploration**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Design Optimization Speed Comparison\n",
    "import numpy as np\n",
    import matplotlib.pyplot as plt\n",
    "\n",
    "# Optimization parameters\n",
    "population_size = 100\n",
    "generations = 1000\n",
    "total_evaluations = population_size * generations\n",
    "\n",
    "# Time calculations\n",
    "fea_time_hours = 2  # hours per FEA simulation\n",
    "ml_time_seconds = 0.02  # seconds per ML prediction\n",
    "\n",
    "# Total computation time\n",
    "total_fea_time = total_evaluations * fea_time_hours  # hours\n",
    "total_ml_time = total_evaluations * ml_time_seconds / 3600  # hours\n",
    "\n",
    "print(\"=== Design Optimization Comparison ===\")\n",
    "print(f\"Optimization problem: {population_size} population × {generations} generations\")\n",
    "print(f\"Total evaluations required: {total_evaluations:,}\")\n",
    "print()\n",
    "print(\"Traditional FEA-based approach:\")\n",
    "print(f\"  Time per evaluation: {fea_time_hours} hours\")\n",
    "print(f\"  Total time: {total_fea_time:,.0f} hours\")\n",
    "print(f\"  Equivalent to: {total_fea_time/24:,.1f} days\")\n",
    "print(f\"  Equivalent to: {total_fea_time/(24*365):,.1f} years\")\n",
    "print()\n",
    "print(\"ML surrogate-based approach:\")\n",
    "print(f\"  Time per evaluation: {ml_time_seconds} seconds\")\n",
    "print(f\"  Total time: {total_ml_time:.2f} hours\")\n",
    "print(f\"  Equivalent to: {total_ml_time*60:.1f} minutes\")\n",
    "print()\n",
    "print(f\"Speedup factor: {total_fea_time/total_ml_time:,.0f}×\")\n",
    "\n",
    "# Visualize the comparison\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "\n",
    "# Time comparison (log scale)\n",
    "methods = ['FEA-based', 'ML-based']\n",
    "times_hours = [total_fea_time, total_ml_time]\n",
    "colors = ['red', 'green']\n",
    "\n",
    "bars = ax1.bar(methods, times_hours, color=colors, alpha=0.7, log=True)\n",
    "ax1.set_ylabel('Total Computation Time (hours, log scale)')\n",
    "ax1.set_title('Design Optimization: Total Time Comparison')\n",
    "ax1.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "# Add value labels on bars\n",
    "for bar, time in zip(bars, times_hours):\n",
    "    height = bar.get_height()\n",
    "    if time > 1:\n",
    "        label = f'{time:,.0f}h\\n({time/8760:.1f}y)'\n",
    "    else:\n",
    "        label = f'{time*60:.1f}m'\n",
    "    ax1.text(bar.get_x() + bar.get_width()/2., height*1.5, label,\n",
    "             ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "# Optimization timeline\n",
    "# Show how much optimization can be done in fixed time\n",
    "fixed_time_hours = 40  # Standard work week\n",
    "evaluations_fea = fixed_time_hours / fea_time_hours\n",
    "evaluations_ml = fixed_time_hours * 3600 / ml_time_seconds\n",
    "\n",
    "ax2.bar(['FEA in 40h', 'ML in 40h'], [evaluations_fea, evaluations_ml], \n",
    "        color=colors, alpha=0.7, log=True)\n",
    "ax2.set_ylabel('Number of Evaluations Possible (log scale)')\n",
    "ax2.set_title('Design Evaluations in Fixed Time (40 hours)')\n",
    "ax2.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "# Add evaluation count labels\n",
    "ax2.text(0, evaluations_fea*2, f'{evaluations_fea:.0f}\\nevaluations',\n",
    "         ha='center', va='bottom', fontweight='bold')\n",
    "ax2.text(1, evaluations_ml*0.5, f'{evaluations_ml:,.0f}\\nevaluations',\n",
    "         ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# What becomes feasible\n",
    "print(\"\\n=== What Becomes Feasible ===\")\n",
    "print(\"With FEA-based optimization:\")\n",
    "print(f\"  In 1 week: {7*24/fea_time_hours:.0f} evaluations\")\n",
    "print(f\"  In 1 month: {30*24/fea_time_hours:.0f} evaluations\")\n",
    "print(\"  Limited to simple parameter sweeps\")\n",
    "print()\n",
    "print(\"With ML-based optimization:\")\n",
    "print(f\"  In 1 week: {7*24*3600/ml_time_seconds:,.0f} evaluations\")\n",
    "print(f\"  In 1 month: {30*24*3600/ml_time_seconds:,.0f} evaluations\")\n",
    "print(\"  Enables comprehensive genetic algorithms\")\n",
    "print(\"  Allows multi-objective optimization\")\n",
    "print(\"  Supports robust design optimization\")"
   ]
