    "## Chapter 2: Predicting Magnetic Field Distributions (CNNs)\n",
    "\n",
    "### Challenge\n",
    "Fast and accurate magnetic field prediction for arbitrary geometries.\n",
    "\n",
    "### Approach\n",
    "Convolutional Neural Networks (CNNs) as surrogate models for field distributions.\n",
    "\n",
    "### Key Contributions\n",
    "- **Encoder-decoder architecture** for pixel-wise field prediction\n",
    "- **Dilated convolutions** to capture long-range spatial dependencies\n",
    "- **Monte Carlo dropout** for uncertainty quantification\n",
    "- **Validation on three problems**: coil, transformer, IPM motor\n",
    "\n",
    "### Results\n",
    "- **0.1-1% prediction error** compared to FEA\n",
    "- **180,000× speedup** vs. FEA\n",
    "- **Uncertainty maps** identify unreliable prediction regions\n",
    "\n",
    "### What You'll Learn\n",
    "- How to train deep CNNs for spatial field prediction\n",
    "- Encoder-decoder architectures for image-to-image regression\n",
    "- Uncertainty quantification in neural networks\n",
    "- Handling geometric inputs for electromagnetic problems"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# CNN Architecture Example\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "class FieldPredictorCNN(nn.Module):\n",
    "    \"\"\"Encoder-deoder CNN for magnetic field prediction\"\"\"\n",
    "    \n",
    "    def __init__(self, input_channels=3, output_channels=2):\n",
    "        super().__init__()\n",
    "        \n",
    "        # Encoder\n",
    "        self.encoder = nn.Sequential(\n",
    "            # Input: geometry + material properties\n",
    "            nn.Conv2d(input_channels, 64, 3, padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.BatchNorm2d(64),\n",
    "            \n",
    "            # Downsampling with dilated convolutions\n",
    "            nn.Conv2d(64, 128, 3, stride=2, padding=1, dilation=1),\n",
    "            nn.ReLU(),\n",
    "            nn.BatchNorm2d(128),\n",
    "            \n",
    "            nn.Conv2d(128, 256, 3, stride=2, padding=2, dilation=2),\n",
    "            nn.ReLU(),\n",
    "            nn.BatchNorm2d(256),\n",
    "            \n",
    "            # Bottleneck\n",
    "            nn.Conv2d(256, 512, 3, padding=4, dilation=4),\n",
    "            nn.ReLU(),\n",
    "            nn.BatchNorm2d(512)\n",
    "        )\n",
    "        \n",
    "        # Decoder\n",
    "        self.decoder = nn.Sequential(\n",
    "            # Upsampling\n",
    "            nn.ConvTranspose2d(512, 256, 3, stride=2, padding=1, output_padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.BatchNorm2d(256),\n",
    "            \n",
    "            nn.ConvTranspose2d(256, 128, 3, stride=2, padding=1, output_padding=1),\n",
    "            nn.ReLU(),\n",
    "            nn.BatchNorm2d(128),\n",
    "            \n",
    "            # Output: magnetic field components\n",
    "            nn.Conv2d(128, output_channels, 1),\n",
    "            nn.Tanh()  # Normalize field outputs\n",
    "        )\n",
    "        \n",
    "        # Dropout for uncertainty quantification\n",
    "        self.dropout = nn.Dropout2d(0.1)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        # Encoder\n",
    "        encoded = self.encoder(x)\n",
    "        \n",
    "        # Apply dropout during training for uncertainty estimation\n",
    "        if self.training:\n",
    "            encoded = self.dropout(encoded)\n",
    "        \n",
    "        # Decoder\n",
    "        output = self.decoder(encoded)\n",
    "        \n",
    "        return output\n",
    "\n",
    "# Create model instance\n",
    "model = FieldPredictorCNN()\n",
    "print(\"CNN Architecture for Field Prediction:\")\n",
    "print(f\"Total parameters: {sum(p.numel() for p in model.parameters()):,}\")\n",
    "print(f\"Trainable parameters: {sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")"
   ]
  },
