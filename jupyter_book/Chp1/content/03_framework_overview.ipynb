    "# DRL Agent Example\n",
    "class DesignAgent(nn.Module):\n",
    "    \"\"\"Deep Reinforcement Learning agent for design\"\"\"\n",
    "    \n",
    "    def __init__(self, state_dim, action_dim, hidden_dim=256):\n",
    "        super().__init__()\n",
    "        \n",
    "        # State encoder\n",
    "        self.state_encoder = nn.Sequential(\n",
    "            nn.Linear(state_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.LayerNorm(hidden_dim)\n",
    "        )\n",
    "        \n",
    "        # Policy network (actor)\n",
    "        self.policy_net = nn.Sequential(\n",
    "            nn.Linear(hidden_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(hidden_dim, action_dim),\n",
    "            nn.Softmax(dim=-1)\n",
    "        )\n",
    "        \n",
    "        # Value network (critic)\n",
    "        self.value_net = nn.Sequential(\n",
    "            nn.Linear(hidden_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(hidden_dim, 1)\n",
    "        )\n",
    "    \n",
    "    def forward(self, state):\n",
    "        encoded = self.state_encoder(state)\n",
    "        policy = self.policy_net(encoded)\n",
    "        value = self.value_net(encoded)\n",
    "        return policy, value.squeeze(-1)\n",
    "    \n",
    "    def select_action(self, state, deterministic=False):\n",
    "        \"\"\"Select action based on current policy\"\"\"\n",
    "        with torch.no_grad():\n",
    "            policy, value = self.forward(state)\n",
    "            \n",
    "            if deterministic:\n",
    "                action = torch.argmax(policy, dim=-1)\n",
    "            else:\n",
    "                action_dist = torch.distributions.Categorical(policy)\n",
    "                action = action_dist.sample()\n",
    "            \n",
    "            return action, policy[action], value\n",
    "\n",
    "# Training loop example\n",
    "def train_design_agent(env, agent, num_episodes=1000):\n",
    "    \"\"\"Train the design agent using policy gradient\"\"\"\n",
    "    optimizer = torch.optim.Adam(agent.parameters(), lr=1e-4)\n",
    "    \n",
    "    episode_rewards = []\n",
    "    \n",
    "    for episode in range(num_episodes):\n",
    "        state = env.reset()\n",
    "        episode_reward = 0\n",
    "        \n",
    "        # Collect trajectory\n",
    "        states, actions, rewards, values = [], [], [], []\n",
    "        \n",
    "        done = False\n",
    "        while not done:\n",
    "            # Convert state to tensor\n",
    "            state_tensor = torch.FloatTensor(state['design'].flatten())\n",
    "            \n",
    "            # Select action\n",
    "            action, action_prob, value = agent.select_action(state_tensor)\n",
    "            \n",
    "            # Execute action\n",
    "            next_state, reward, done = env.step(action.item())\n",
    "            \n",
    "            # Store experience\n",
    "            states.append(state_tensor)\n",
    "            actions.append(action)\n",
    "            rewards.append(reward)\n",
    "            values.append(value)\n",
    "            \n",
    "            state = next_state\n",
    "            episode_reward += reward\n",
    "        \n",
    "        episode_rewards.append(episode_reward)\n",
    "        \n",
    "        # Update policy (simplified policy gradient)\n",
    "        if episode % 10 == 0:  # Update every 10 episodes\n",
    "            optimizer.zero_grad()\n",
    "            \n",
    "            # Calculate returns and advantages\n",
    "            returns = []\n",
    "            R = 0\n",
    "            for r in reversed(rewards):\n",
    "                R = r + 0.99 * R  # Discount factor\n",
    "                returns.insert(0, R)\n",
    "            \n",
    "            returns = torch.FloatTensor(returns)\n",
    "            values = torch.stack(values)\n",
    "            advantages = returns - values\n",
    "            \n",
    "            # Policy gradient loss\n",
    "            policy_loss = []\n",
    "            for state, action, advantage in zip(states, actions, advantages):\n",
    "                _, logits, _ = agent(state.unsqueeze(0))\n",
    "                log_prob = torch.log(logits[0, action] + 1e-8)\n",
    "                policy_loss.append(-log_prob * advantage)\n",
    "            \n",
    "            policy_loss = torch.stack(policy_loss).mean()\n",
    "            \n",
    "            # Value function loss\n",
    "            value_loss = nn.MSELoss()(values, returns)\n",
    "            \n",
    "            # Total loss\n",
    "            total_loss = policy_loss + 0.5 * value_loss\n",
    "            \n",
    "            total_loss.backward()\n",
    "            optimizer.step()\n",
    "        \n",
    "        if episode % 100 == 0:\n",
    "            avg_reward = np.mean(episode_rewards[-100:]) if len(episode_rewards) >= 100 else np.mean(episode_rewards)\n",
    "            print(f\"Episode {episode}, Average Reward: {avg_reward:.2f}\")\n",
    "    \n",
    "    return episode_rewards\n",
    "\n",
    "# Create agent instance\n",
    "state_dim = 256  # Flattened 16x16 grid\n",
    "action_dim = 256  # 16x16 possible actions\n",
    "agent = DesignAgent(state_dim, action_dim)\n",
    "\n",
    "print(\"Deep Reinforcement Learning Design Agent:\")\n",
    "print(f\"State dimension: {state_dim}\")\n",
    "print(f\"Action dimension: {action_dim}\")\n",
    "print(f\"Total parameters: {sum(p.numel() for p in agent.parameters()):,}\")\n",
    "print(\"\\nAgent architecture includes:\")\n",
    "print(\"- State encoder for design representation\")\n",
    "print(\"- Policy network (actor) for action selection\")\n",
    "print(\"- Value network (critic) for state evaluation\")\n",
    "print(\"- Policy gradient training with advantage estimation\")"
   ]
