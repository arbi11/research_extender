    "---\n",
    "\n",
    "## Chapter 4: Topology Optimization with Sequential Formulation (MDP)\n",
    "\n",
    "### Challenge\n",
    "Free-form geometry optimization without manufacturability issues (checkerboard patterns, floating islands).\n",
    "\n",
    "### Approach\n",
    "Novel sequence-based topology optimization formulated as Markov Decision Process (MDP).\n",
    "\n",
    "### Key Contributions\n",
    "- **Sequential material deposition** ensures connectivity\n",
    "- **No post-processing filters** or smoothing required\n",
    "- **Naturally manufacturable designs**\n",
    "- **Enables tree-search algorithms** for optimization\n",
    "\n",
    "### Results\n",
    "- Optimized synchronous reluctance motor barrier shapes\n",
    "- **Zero checkerboard artifacts**\n",
    "- **Direct manufacturability** without additional constraints\n",
    "\n",
    "### What You'll Learn\n",
    "- Reformulating optimization problems as sequential decision processes\n",
    "- Markov Decision Process formulation for design problems\n",
    "- Ensuring manufacturability through sequential construction\n",
    "- Tree-search algorithms for design optimization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# MDP Formulation Example\n",
    "class TopologyMDP:\n",
    "    \"\"\"Markov Decision Process for topology optimization\"\"\"\n",
    "    \n",
    "    def __init__(self, grid_size=(32, 32), max_material=0.3):\n",
    "        self.grid_size = grid_size\n",
    "        self.max_material = max_material\n",
    "        self.total_cells = grid_size[0] * grid_size[1]\n",
    "        self.max_steps = int(self.total_cells * max_material)\n",
    "        \n",
    "        # Action space: add material at (row, col) position\n",
    "        self.action_space = [(i, j) for i in range(grid_size[0]) for j in range(grid_size[1])]\n",
    "        \n",
    "        # State space: current material distribution\n",
    "        self.reset()\n",
    "    \n",
    "    def reset(self):\n",
    "        \"\"\"Reset to initial state\"\"\"\n",
    "        self.current_design = np.zeros(self.grid_size)\n",
    "        self.material_added = 0\n",
    "        self.step_count = 0\n",
    "        return self.get_state()\n",
    "    \n",
    "    def get_state(self):\n",
    "        \"\"\"Get current state representation\"\"\"\n",
    "        return {\n",
    "            'design': self.current_design.copy(),\n",
    "            'material_fraction': self.material_added / self.max_steps,\n",
    "            'step': self.step_count\n",
    "        }\n",
    "    \n",
    "    def is_valid_action(self, action):\n",
    "        \"\"\"Check if action is valid\"\"\"\n",
    "        row, col = action\n",
    "        \n",
    "        # Can't add material where it already exists\n",
    "        if self.current_design[row, col] > 0:\n",
    "            return False\n",
    "        \n",
    "        # Connectivity constraint: must connect to existing material or start region\n",
    "        if self.material_added > 0:\n",
    "            has_neighbor = False\n",
    "            for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:\n",
    "                nr, nc = row + dr, col + dc\n",
    "                if (0 <= nr < self.grid_size[0] and \n",
    "                    0 <= nc < self.grid_size[1] and \n",
    "                    self.current_design[nr, nc] > 0):\n",
    "                    has_neighbor = True\n",
    "                    break\n",
    "            if not has_neighbor:\n",
    "                return False\n",
    "        \n",
    "        return True\n",
    "    \n",
    "    def step(self, action):\n",
    "        \"\"\"Execute action and return new state, reward, done\"\"\"\n",
    "        if not self.is_valid_action(action):\n",
    "            return self.get_state(), -10, True  # Penalty for invalid action\n",
    "        \n",
    "        row, col = action\n",
    "        self.current_design[row, col] = 1\n",
    "        self.material_added += 1\n",
    "        self.step_count += 1\n",
    "        \n",
    "        # Calculate reward (simplified - would use FEA in practice)\n",
    "        reward = self.calculate_reward()\n",
    "        \n",
    "        # Check if episode is done\n",
    "        done = (self.material_added >= self.max_steps or \n",
    "                self.step_count >= self.max_steps)\n",
    "        \n",
    "        return self.get_state(), reward, done\n",
    "    \n",
    "    def calculate_reward(self):\n",
    "        \"\"\"Calculate reward based on current design\"\"\"\n",
    "        # Simplified reward function\n",
    "        # In practice, this would call FEA to evaluate electromagnetic performance\n",
    "        \n",
    "        # Reward for material efficiency\n",
    "        efficiency_reward = -0.1 * self.material_added\n",
    "        \n",
    "        # Reward for design features (simplified)\n",
    "        if self.material_added > 10:\n",
    "            # Add reward for creating flux barriers\n",
    "            flux_barrier_reward = 0.5\n",
    "        else:\n",
    "            flux_barrier_reward = 0\n",
    "        \n",
    "        return efficiency_reward + flux_barrier_reward\n",
    "\n",
    "# Create MDP instance\n",
    "mdp = TopologyMDP(grid_size=(16, 16))\n",
    "print(\"Topology Optimization MDP:\")\n",
    "print(f\"Grid size: {mdp.grid_size}\")\n",
    "print(f\"Total cells: {mdp.total_cells}\")\n",
    "print(f\"Max material cells: {mdp.max_steps}\")\n",
    "print(f\"Action space size: {len(mdp.action_space)}\")\n",
    "\n",
    "# Demonstrate one episode\n",
    "state = mdp.reset()\n",
    "print(f\"\\nStarting episode...\")\n",
    "for step in range(10):\n",
    "    # Random valid action\n",
    "    valid_actions = [a for a in mdp.action_space if mdp.is_valid_action(a)]\n",
    "    if not valid_actions:\n",
    "        break\n",
    "    \n",
    "    action = valid_actions[np.random.randint(len(valid_actions))]\n",
    "    new_state, reward, done = mdp.step(action)\n",
    "    \n",
    "    print(f\"Step {step+1}: Added material at {action}, Reward: {reward:.2f}\")\n",
    "    \n",
    "    if done:\n",
    "        break\n",
    "\n",
    "print(f\"Final material fraction: {state['material_fraction']:.2f}\")"
   ]
