    "---\n",
    "\n",
    "## Chapter 3: Performance Map Prediction (RNNs)\n",
    "\n",
    "### Challenge\n",
    "Predict motor efficiency and power factor maps over entire torque-speed operating ranges.\n",
    "\n",
    "### Approach\n",
    "Recurrent Neural Networks (RNNs) with attention mechanism for sequence-to-sequence mapping.\n",
    "\n",
    "### Key Contributions\n",
    "- **Variable-length sequence modeling** for performance maps\n",
    "- **Attention mechanism** for capturing spatial correlations in efficiency distributions\n",
    "- **Transfer learning** to reduce data requirements across motor types\n",
    "- **End-to-end vs. modular architecture comparison**\n",
    "\n",
    "### Results\n",
    "- **1-1.5% per-point error** on efficiency maps\n",
    - **2-3 seconds** for complete efficiency map generation (vs. 1-2 hours with FEA)\n",
    "- **Transfer learning** reduces training data needs by 60%\n",
    "\n",
    "### What You'll Learn\n",
    "- Handling variable-length outputs in neural networks\n",
    "- Attention mechanisms for sequence modeling\n",
    "- Transfer learning techniques across related tasks\n",
    "- Performance prediction for operating ranges"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# RNN Architecture Example\n",
    "class PerformanceMapRNN(nn.Module):\n",
    "    \"\"\"RNN with attention for performance map prediction\"\"\"\n",
    "    \n",
    "    def __init__(self, input_size=12, hidden_size=128, num_layers=2):\n",
    "        super().__init__()\n",
    "        \n",
    "        # Design parameter encoder\n",
    "        self.param_encoder = nn.Sequential(\n",
    "            nn.Linear(input_size, hidden_size),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.2)\n",
    "        )\n",
    "        \n",
    "        # RNN for sequence generation\n",
    "        self.rnn = nn.LSTM(\n",
    "            input_size=hidden_size,\n",
    "            hidden_size=hidden_size,\n",
    "            num_layers=num_layers,\n",
    "            batch_first=True,\n",
    "            dropout=0.2\n",
    "        )\n",
    "        \n",
    "        # Attention mechanism\n",
    "        self.attention = nn.MultiheadAttention(\n",
    "            embed_dim=hidden_size,\n",
    "            num_heads=8,\n",
    "            dropout=0.1,\n",
    "            batch_first=True\n",
    "        )\n",
    "        \n",
    "        # Output decoder\n",
    "        self.output_decoder = nn.Sequential(\n",
    "            nn.Linear(hidden_size, hidden_size // 2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(hidden_size // 2, 3)  # efficiency, power factor, torque\n",
    "        )\n",
    "        \n",
    "        # Operating point encoder (speed, torque conditions)\n",
    "        self.op_encoder = nn.Linear(2, hidden_size)\n",
    "    \n",
    "    def forward(self, design_params, operating_points):\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            design_params: [batch_size, input_size] - motor design parameters\n",
    "            operating_points: [batch_size, seq_len, 2] - speed and torque conditions\n",
    "        \"\"\"\n",
    "        batch_size, seq_len, _ = operating_points.shape\n",
    "        \n",
    "        # Encode design parameters\n",
    "        design_encoded = self.param_encoder(design_params)  # [batch_size, hidden_size]\n",
    "        design_encoded = design_encoded.unsqueeze(1).expand(-1, seq_len, -1)  # [batch_size, seq_len, hidden_size]\n",
    "        \n",
    "        # Encode operating points\n",
    "        op_encoded = self.op_encoder(operating_points)  # [batch_size, seq_len, hidden_size]\n",
    "        \n",
    "        # Combine design and operating point information\n",
    "        combined_input = design_encoded + op_encoded  # [batch_size, seq_len, hidden_size]\n",
    "        \n",
    "        # Apply attention\n",
    "        attended, _ = self.attention(combined_input, combined_input, combined_input)\n",
    "        \n",
    "        # RNN processing\n",
    "        rnn_out, _ = self.rnn(attended)  # [batch_size, seq_len, hidden_size]\n",
    "        \n",
    "        # Generate performance predictions\n",
    "        output = self.output_decoder(rnn_out)  # [batch_size, seq_len, 3]\n",
    "        \n",
    "        return output\n",
    "\n",
    "# Create model instance\n",
    "rnn_model = PerformanceMapRNN()\n",
    "print(\"RNN Architecture for Performance Map Prediction:\")\n",
    "print(f\"Total parameters: {sum(p.numel() for p in rnn_model.parameters()):,}\")\n",
    "print(f\"Trainable parameters: {sum(p.numel() for p in rnn_model.parameters() if p.requires_grad):,}\")\n",
    "\n",
    "# Example usage\n",
    "batch_size, seq_len = 4, 50\n",
    "design_params = torch.randn(batch_size, 12)\n",
    "operating_points = torch.randn(batch_size, seq_len, 2)\n",
    "\n",
    "with torch.no_grad():\n",
    "    performance_maps = rnn_model(design_params, operating_points)\n",
    "    print(f\"\\nOutput shape: {performance_maps.shape}\")\n",
    "    print(f\"Expected: [batch_size={batch_size}, seq_len={seq_len}, outputs=3]\")"
   ]
  },
