    "---\n",
    "\n",
    "## 2. Generalization Limitations\n",
    "\n",
    "### Problem: ML Models Can Fail Silently on Out-of-Distribution Inputs\n",
    "\n",
    "One of the most dangerous aspects of applying ML to engineering design is the potential for silent failures:\n",
    "\n",
    "**The Silent Failure Problem:**\n",
    "- **No natural error indicators** like in physics-based simulations\n",
    "- **Confidence without competence** - models can be confidently wrong\n",
    "- **Extrapolation risk** - poor performance outside training data\n",
    "- **Catastrophic errors** possible in engineering applications\n",
    "\n",
    "**Types of Generalization Failures:**\n",
    "\n",
    "**1. Geometric Extrapolation**\n",
    "- Designs with parameters outside training ranges\n",
    "- Novel topology combinations\n",
    "- Extreme aspect ratios or feature sizes\n",
    "- Unusual material property combinations\n",
    "\n",
    "**2. Performance Extrapolation**\n",
    "- Operating conditions beyond training envelope\n",
    "- Novel performance objectives\n",
    "- Different constraint combinations\n",
    "- New failure modes or physics phenomena"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generalization Limitations Demonstration\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.neural_network import MLPRegressor\n",
    "from sklearn.metrics import mean_absolute_error\n",
    "\n",
    "# Generate synthetic electromagnetic design data\n",
    "def generate_synthetic_data(n_samples=1000, noise_level=0.05):\n",
    "    \"\"\"Generate synthetic motor design data\"\"\"\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    # Design parameters (within training bounds)\n",
    "    X = np.random.rand(n_samples, 3)\n",
    "    \n",
    "    # Scale to realistic ranges\n",
    "    X[:, 0] = 20 + X[:, 0] * 30      # stator radius: 20-50mm\n",
    "    X[:, 1] = 0.5 + X[:, 1] * 1.5     # air gap: 0.5-2.0mm\n",
    "    X[:, 2] = 2 + X[:, 2] * 4          # magnet thickness: 2-6mm\n",
    "    \n",
    "    # Performance (simplified electromagnetic efficiency model)\n",
    "    y = 85 + 5 * np.exp(-((X[:, 1] - 1.0)**2) / 0.3) + \\\n",
    "        2 * np.exp(-((X[:, 2] - 4.0)**2) / 1.5) + \\\n",
    "        0.1 * (X[:, 0] - 35)**2 / 100\n",
    "    \n",
    "    # Add noise\n",
    "    y += np.random.normal(0, noise_level, n_samples)\n",
    "    \n",
    "    return X, y\n",
    "\n",
    "# Generate training data (normal range)\n",
    "X_train, y_train = generate_synthetic_data(1000, noise_level=0.1)\n",
    "\n",
    "# Generate test data within distribution\n",
    "X_test_in, y_test_in = generate_synthetic_data(200, noise_level=0.1)\n",
    "\n",
    "# Generate test data outside distribution (extrapolation)\n",
    "np.random.seed(123)\n",
    "n_out = 100\n",
    "X_test_out = np.zeros((n_out, 3))\n",
    "\n",
    "# Extrapolate in different ways\n",
    "X_test_out[:25, 0] = 55 + np.random.rand(25) * 10  # stator radius: 55-65mm (outside training)\n",
    "X_test_out[:25, 1] = 0.5 + np.random.rand(25) * 1.5\n",
    "X_test_out[:25, 2] = 2 + np.random.rand(25) * 4\n",
    "\n",
    "X_test_out[25:50, 0] = 20 + np.random.rand(25) * 30\n",
    "X_test_out[25:50, 1] = 2.2 + np.random.rand(25) * 0.8  # air gap: 2.2-3.0mm (outside training)\n",
    "X_test_out[25:50, 2] = 2 + np.random.rand(25) * 4\n",
    "\n",
    "X_test_out[50:75, 0] = 20 + np.random.rand(25) * 30\n",
    "X_test_out[50:75, 1] = 0.5 + np.random.rand(25) * 1.5\n",
    "X_test_out[50:75, 2] = 6.5 + np.random.rand(25) * 2  # magnet thickness: 6.5-8.5mm (outside training)\n",
    "\n",
    "X_test_out[75:, 0] = 15 + np.random.rand(25) * 5   # stator radius: 15-20mm (outside training)\n",
    "X_test_out[75:, 1] = 0.2 + np.random.rand(25) * 0.3  # air gap: 0.2-0.5mm (outside training)\n",
    "X_test_out[75:, 2] = 1 + np.random.rand(25) * 1     # magnet thickness: 1-2mm (outside training)\n",
    "\n",
    "# True performance for out-of-distribution data\n",
    "y_test_out = 85 + 5 * np.exp(-((X_test_out[:, 1] - 1.0)**2) / 0.3) + \\\n",
    "             2 * np.exp(-((X_test_out[:, 2] - 4.0)**2) / 1.5) + \\\n",
    "             0.1 * (X_test_out[:, 0] - 35)**2 / 100\n",
    "\n",
    "# Train neural network\n",
    "print(\"=== Generalization Limitations Demonstration ===\")\n",
    "print(\"Training neural network on in-distribution data...\")\n",
    "\n",
    "model = MLPRegressor(hidden_layer_sizes=(64, 32, 16), max_iter=1000, random_state=42)\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "# Evaluate on different test sets\n",
    "y_pred_in = model.predict(X_test_in)\n",
    "y_pred_out = model.predict(X_test_out)\n",
    "\n",
    "# Calculate errors\n",
    "mae_in = mean_absolute_error(y_test_in, y_pred_in)\n",
    "mae_out = mean_absolute_error(y_test_out, y_pred_out)\n",
    "\n",
    "print(f\"\\nPerformance Evaluation:\")\n",
    "print(f\"In-distribution test MAE: {mae_in:.3f}\")\n",
    "print(f\"Out-of-distribution test MAE: {mae_out:.3f}\")\n",
    "print(f\"Error increase factor: {mae_out/mae_in:.1f}×\")\n",
    "\n",
    "# Visualize generalization performance\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "fig.suptitle('Neural Network Generalization Analysis', fontsize=16)\n",
    "\n",
    "# Plot 1: In-distribution performance\n",
    "ax = axes[0, 0]\n",
    "ax.scatter(y_test_in, y_pred_in, alpha=0.6, color='blue')\n",
    "ax.plot([y_test_in.min(), y_test_in.max()], [y_test_in.min(), y_test_in.max()], 'r--', lw=2)\n",
    "ax.set_xlabel('True Efficiency (%)')\n",
    "ax.set_ylabel('Predicted Efficiency (%)')\n",
    "ax.set_title(f'In-Distribution Performance (MAE: {mae_in:.3f})')\n",
    "ax.grid(True, alpha=0.3)\n",
    "ax.axis('equal')\n",
    "\n",
    "# Plot 2: Out-of-distribution performance\n",
    "ax = axes[0, 1]\n",
    "ax.scatter(y_test_out, y_pred_out, alpha=0.6, color='red')\n",
    "ax.plot([y_test_out.min(), y_test_out.max()], [y_test_out.min(), y_test_out.max()], 'r--', lw=2)\n",
    "ax.set_xlabel('True Efficiency (%)')\n",
    "ax.set_ylabel('Predicted Efficiency (%)')\n",
    "ax.set_title(f'Out-of-Distribution Performance (MAE: {mae_out:.3f})')\n",
    "ax.grid(True, alpha=0.3)\n",
    "ax.axis('equal')\n",
    "\n",
    "# Plot 3: Error distribution\n",
    "ax = axes[1, 0]\n",
    "errors_in = np.abs(y_test_in - y_pred_in)\n",
    "errors_out = np.abs(y_test_out - y_pred_out)\n",
    "\n",
    "ax.hist(errors_in, bins=20, alpha=0.7, label='In-distribution', color='blue', density=True)\n",
    "ax.hist(errors_out, bins=20, alpha=0.7, label='Out-of-distribution', color='red', density=True)\n",
    "ax.set_xlabel('Absolute Error')\n",
    "ax.set_ylabel('Density')\n",
    "ax.set_title('Error Distribution Comparison')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 4: Parameter space visualization\n",
    "ax = axes[1, 1]\n",
    "\n",
    "# Show training data range vs test data\n",
    "train_colors = ['blue', 'green', 'orange']\n",
    "test_colors = ['red', 'purple', 'brown']\n",
    "param_names = ['Stator Radius (mm)', 'Air Gap (mm)', 'Magnet Thickness (mm)']\n",
    "\n",
    "for i in range(3):\n",
    "    # Training data range\n",
    "    ax.scatter([i] * len(X_train), X_train[:, i], alpha=0.2, color=train_colors[i], s=2)\n",
    "    \n",
    "    # Test data ranges\n",
    "    ax.scatter([i + 0.3] * len(X_test_in), X_test_in[:, i], alpha=0.6, color='green', s=10)\n",
    "    ax.scatter([i + 0.6] * len(X_test_out), X_test_out[:, i], alpha=0.6, color='red', s=10)\n",
    "\n",
    "ax.set_xticks([0, 1, 2])\n",
    "ax.set_xticklabels(param_names)\n",
    "ax.set_ylabel('Parameter Value')\n",
    "ax.set_title('Parameter Range Comparison')\n",
    "ax.legend(['Training', 'Test (In)', 'Test (Out)'], loc='upper right')\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Analyze specific failure cases\n",
    "print(\"\\n=== Specific Failure Analysis ===\")\n",
    "worst_errors_idx = np.argsort(errors_out)[-5:]  # 5 worst predictions\n",
    "\n",
    "print(\"Worst 5 out-of-distribution predictions:\")\n",
    "for i, idx in enumerate(worst_errors_idx):\n",
    "    print(f\"  {i+1}. True: {y_test_out[idx]:.2f}, Predicted: {y_pred_out[idx]:.2f}, \"\n",
