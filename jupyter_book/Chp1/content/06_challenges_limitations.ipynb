    "# Transfer Learning Impact Analysis\n",
    "def analyze_transfer_learning_impact():\n",
    "    \"\"\"Analyze the impact of transfer learning on data requirements\"\"\"\n",
    "    \n",
    "    scenarios = [\n",
    "        {\n",
    "            'name': 'From Scratch',\n",
    "            'base_data': 0,\n",
    "            'new_data': 10000,\n",
    "            'transfer_efficiency': 1.0\n",
    "        },\n",
    "        {\n",
    "            'name': 'Same Motor Type',\n",
    "            'base_data': 8000,\n",
    "            'new_data': 2000,\n",
    "            'transfer_efficiency': 0.8\n",
    "        },\n",
    "        {\n",
    "            'name': 'Different Motor Type',\n",
    "            'base_data': 8000,\n",
    "            'new_data': 3000,\n",
    "            'transfer_efficiency': 0.6\n",
    "        },\n",
    "        {\n",
    "            'name': 'Related Application',\n",
    "            'base_data': 8000,\n",
    "            'new_data': 5000,\n",
    "            'transfer_efficiency': 0.4\n",
    "        }\n",
    "    ]\n",
    "    \n",
    "    print(\"=== Transfer Learning Impact Analysis ===\")\n",
    "    print(\"Scenario              | Base Data | New Data | Total Effective | Data Reduction\")\n",
    "    print(\"-\" * 80)\n",
    "    \n",
    "    for scenario in scenarios:\n",
    "        total_effective = scenario['base_data'] * scenario['transfer_efficiency'] + scenario['new_data']\n",
    "        reduction = (1 - total_effective / 10000) * 100\n",
    "        \n",
    "        print(f\"{scenario['name']:<20} | {scenario['base_data']:>8} | {scenario['new_data']:>8} | {total_effective:>14.0f} | {reduction:>13.1f}%\")\n",
    "    \n",
    "    return scenarios\n",
    "\n",
    "# Efficient Sampling Analysis\n",
    "def analyze_sampling_strategies():\n",
    "    \"\"\"Compare different sampling strategies\"\"\"\n",
    "    \n",
    "    strategies = {\n",
    "        'Random Sampling': {'coverage': 0.3, 'efficiency': 1.0},\n",
    "        'Grid Sampling': {'coverage': 0.5, 'efficiency': 0.8},\n",
    "        'Latin Hypercube': {'coverage': 0.8, 'efficiency': 0.9},\n",
    "        'Adaptive Sampling': {'coverage': 0.9, 'efficiency': 1.2},\n",
    "        'Active Learning': {'coverage': 0.95, 'efficiency': 1.5}\n",
    "    }\n",
    "    \n",
    "    print(\"\\n=== Sampling Strategy Comparison ===\")\n",
    "    print(\"Strategy              | Space Coverage | Sampling Efficiency\")\n",
    "    print(\"-\" * 65)\n",
    "    \n",
    "    for strategy, metrics in strategies.items():\n",
    "        print(f\"{strategy:<20} | {metrics['coverage']:>12.1%} | {metrics['efficiency']:>16.1f}\")\n",
    "    \n",
    "    return strategies\n",
    "\n",
    "# Run analyses\n",
    "transfer_scenarios = analyze_transfer_learning_impact()\n",
    "sampling_strategies = analyze_sampling_strategies()\n",
    "\n",
    "# Visualization\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "\n",
    "# Transfer learning impact\n",
    "names = [s['name'] for s in transfer_scenarios]\n",
    "new_data = [s['new_data'] for s in transfer_scenarios]\n",
    "colors = ['red', 'orange', 'yellow', 'green']\n",
    "\n",
    "bars1 = ax1.bar(names, new_data, color=colors, alpha=0.7)\n",
    "ax1.set_ylabel('New Data Required')\n",
    "ax1.set_title('Transfer Learning: Data Reduction')\n",
    "ax1.set_xticklabels(names, rotation=45, ha='right')\n",
    "ax1.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "# Add value labels\n",
    "for bar, value in zip(bars1, new_data):\n",
    "    height = bar.get_height()\n",
    "    ax1.text(bar.get_x() + bar.get_width()/2., height + max(new_data)*0.01,\n",
    "             f'{value:,}', ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "# Sampling strategies\n",
    "strategy_names = list(sampling_strategies.keys())\n",
    "coverage = [s['coverage'] for s in sampling_strategies.values()]\n",
    "efficiency = [s['efficiency'] for s in sampling_strategies.values()]\n",
    "\n",
    "scatter = ax2.scatter(coverage, efficiency, s=200, alpha=0.7, c=range(len(strategy_names)), cmap='viridis')\n",
    "ax2.set_xlabel('Design Space Coverage')\n",
    "ax2.set_ylabel('Sampling Efficiency')\n",
    "ax2.set_title('Sampling Strategy Performance')\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "# Add labels\n",
    "for i, name in enumerate(strategy_names):\n",
    "    ax2.annotate(name, (coverage[i], efficiency[i]), \n",
    "                xytext=(5, 5), textcoords='offset points', fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n=== Key Takeaways ===\")\n",
    "print(\"• Transfer learning can reduce data requirements by 60-80%\")\n",
    "print(\"• Smart sampling strategies improve space coverage and efficiency\")\n",
    "print(\"• Active learning focuses data generation on most informative regions\")\n",
    "print(\"• Combining strategies provides maximum benefit\")"
   ]
