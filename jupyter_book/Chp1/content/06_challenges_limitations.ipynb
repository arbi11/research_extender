    "# Uncertainty Quantification Demonstration\n",
    "def monte_carlo_dropout_predict(model, X, n_samples=100):\n",
    "    \"\"\"Perform Monte Carlo dropout for uncertainty estimation\"\"\"\n",
    "    predictions = []\n",
    "    \n",
    "    for _ in range(n_samples):\n",
    "        # Enable dropout during inference\n",
    "        # Note: This is a simplified version - in practice, you'd modify the model\n",
    "        pred = model.predict(X) + np.random.normal(0, 0.1, len(X))  # Add noise to simulate MC dropout\n",
    "        predictions.append(pred)\n",
    "    \n",
    "    predictions = np.array(predictions)\n",
    "    mean_pred = np.mean(predictions, axis=0)\n",
    "    std_pred = np.std(predictions, axis=0)\n",
    "    \n",
    "    return mean_pred, std_pred\n",
    "\n",
    "# Demonstrate uncertainty quantification\n",
    "print(\"=== Uncertainty Quantification Demonstration ===\")\n",
    "\n",
    "# Generate mixed test set (in and out of distribution)\n",
    "X_mixed = np.vstack([X_test_in[:50], X_test_out[:50]])\n",
    "y_mixed = np.hstack([y_test_in[:50], y_test_out[:50]])\n",
    "\n",
    "# Get predictions with uncertainty\n",
    "mean_pred, std_pred = monte_carlo_dropout_predict(model, X_mixed, n_samples=50)\n",
    "\n",
    "# Analyze uncertainty for in vs out of distribution\n",
    "uncertainty_in = std_pred[:50]  # First 50 are in-distribution\n",
    "uncertainty_out = std_pred[50:]  # Last 50 are out-of-distribution\n",
    "\n",
    "print(f\"Average uncertainty (in-distribution): {np.mean(uncertainty_in):.3f}\")\n",
    "print(f\"Average uncertainty (out-of-distribution): {np.mean(uncertainty_out):.3f}\")\n",
    "print(f\"Uncertainty ratio: {np.mean(uncertainty_out)/np.mean(uncertainty_in):.1f}×\")\n",
    "\n",
    "# Visualization\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "\n",
    "# Uncertainty comparison\n",
    "ax1.hist(uncertainty_in, bins=15, alpha=0.7, label='In-distribution', color='blue', density=True)\n",
    "ax1.hist(uncertainty_out, bins=15, alpha=0.7, label='Out-of-distribution', color='red', density=True)\n",
    "ax1.set_xlabel('Prediction Uncertainty (Std Dev)')\n",
    "ax1.set_ylabel('Density')\n",
    "ax1.set_title('Uncertainty Distribution Comparison')\n",
    "ax1.legend()\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Uncertainty vs error correlation\n",
    "errors_mixed = np.abs(y_mixed - mean_pred)\n",
    "scatter = ax2.scatter(std_pred, errors_mixed, alpha=0.6, c=['blue']*50 + ['red']*50)\n",
    "ax2.set_xlabel('Prediction Uncertainty')\n",
    "ax2.set_ylabel('Prediction Error')\n",
    "ax2.set_title('Uncertainty vs Error Correlation')\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "# Add legend\n",
    "blue_patch = plt.Line2D([0], [0], marker='o', color='w', markerfacecolor='blue', markersize=10, label='In-distribution')\n",
    "red_patch = plt.Line2D([0], [0], marker='o', color='w', markerfacecolor='red', markersize=10, label='Out-of-distribution')\n",
    "ax2.legend(handles=[blue_patch, red_patch])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Uncertainty-based filtering\n",
    "uncertainty_threshold = np.percentile(uncertainty_in, 90)  # 90th percentile of in-distribution uncertainty\n",
    "\n",
    "print(f\"\\n=== Uncertainty-Based Filtering ===\")\n",
    "print(f\"Uncertainty threshold (90th percentile of in-distribution): {uncertainty_threshold:.3f}\")\n",
    "\n",
    "# Count predictions above threshold\n",
    "high_uncertainty_in = np.sum(uncertainty_in > uncertainty_threshold)\n",
    "high_uncertainty_out = np.sum(uncertainty_out > uncertainty_threshold)\n",
    "\n",
    "print(f\"In-distribution samples above threshold: {high_uncertainty_in}/50 ({high_uncertainty_in*2:.0f}%)\")\n",
    "print(f\"Out-of-distribution samples above threshold: {high_uncertainty_out}/50 ({high_uncertainty_out*2:.0f}%)\")\n",
    "print(f\"Detection rate: {high_uncertainty_out/50*100:.0f}% of out-of-distribution samples detected\")\n",
