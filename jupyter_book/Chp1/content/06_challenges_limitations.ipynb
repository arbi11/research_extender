    "# Physics-aware loss function example\n",
    "def physics_informed_loss(y_pred, y_true, design_params, physics_weight=0.1):\n",
    "    \"\"\"Example of physics-informed loss function\"\"\"\n",
    "    \n",
    "    # Standard MSE loss\n",
    "    mse_loss = np.mean((y_pred - y_true)**2)\n",
    "    \n",
    "    # Physics constraints\n",
    "    physics_loss = 0\n",
    "    \n",
    "    # Energy conservation constraint\n",
    "    input_power = design_params[:, 0]  # Input power from design parameters\n",
    "    output_power = y_pred  # Predicted output power\n",
    "    efficiency = output_power / input_power\n",
    "    \n",
    "    # Penalize efficiencies > 100% (energy conservation violation)\n",
    "    energy_violation = np.maximum(0, efficiency - 1.0)\n",
    "    physics_loss += np.mean(energy_violation**2)\n",
    "    \n",
    "    # Material saturation constraint\n",
    "    magnetic_field = design_params[:, 1]  # Predicted magnetic field\n",
    "    max_field = 2.2  # Tesla (iron saturation)\n",
    "    material_violation = np.maximum(0, magnetic_field - max_field)\n",
    "    physics_loss += np.mean(material_violation**2)\n",
    "    \n",
    "    # Total loss\n",
    "    total_loss = mse_loss + physics_weight * physics_loss\n",
    "    \n",
    "    return total_loss, mse_loss, physics_loss\n",
    "\n",
    "print(\"\\n=== Physics-Informed Loss Function Example ===\")\n",
    "print(\"Total Loss = MSE Loss + λ × Physics Loss\")\n",
    "print()\n",
