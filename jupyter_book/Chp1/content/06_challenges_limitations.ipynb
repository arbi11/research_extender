    "print(\"• MSE Loss: Standard prediction accuracy\")\n",
    "print(\"• Physics Loss: Penalty for violating physical laws\")\n",
    "print(\"• λ: Weight for physics compliance vs. accuracy\")\n",
    "print()\n",
