    "print(\"• Guarantees physically plausible predictions\")\n",
    "print(\"• Reduces data requirements by encoding known physics\")\n",
    "print(\"• Improves generalization to new parameter ranges\")\n",
    "print(\"• Provides interpretable failure modes\")"
