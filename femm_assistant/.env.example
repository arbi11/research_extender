# Copy to .env; never commit .env.
# Generate a long random access token, for example with: openssl rand -hex 24
ASSISTANT_TOKEN=replace-with-a-long-random-token

# Optional for form-based use, required for natural-language requests.
OPENROUTER_API_KEY=
# Drafting model; the API key remains server-side.
AI_MODEL=openai/gpt-4.1-mini
AI_BASE_URL=https://openrouter.ai/api/v1

# For the public HTTPS profile only. Point this DNS name at your VPS first.
DOMAIN=localhost
