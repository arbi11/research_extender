# Copy to .env; never commit .env.
# Generate a long random access token, for example with: openssl rand -hex 24
ASSISTANT_TOKEN=replace-with-a-long-random-token

# Optional for form-based use, required for natural-language requests.
OPENROUTER_API_KEY=
# Drafting default for new setups; preserve any existing explicit model override.
# The API key remains server-side.
AI_MODEL=google/gemini-3.1-flash-lite
AI_BASE_URL=https://openrouter.ai/api/v1

# Jev selects a fixed function and diagnoses actual function errors; no approval score.
DECISION_MODEL=typesafe/jev-1.14
DECISION_BASE_URL=https://openrouter.ai/api/alpha
# Existing DECISION_THRESHOLD values are ignored. Preserve existing .env settings.

# Optional manual image review. Empty VISION_MODEL disables it; findings are advisory.
VISION_MODEL=google/gemini-3.1-flash-lite

# For the public HTTPS profile only. Point this DNS name at your VPS first.
DOMAIN=localhost
