    </edge>
    <edge source="Model" target="Reality">
      <data key="d6">1.0</data>
      <data key="d7">A model is an approximation of reality and will not reflect all of reality.</data>
      <data key="d8">approximation,representation</data>
      <data key="d9">chunk-75365c11d58d9301541e75f2ba5f03ec</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760286272</data>
    </edge>
    <edge source="Model" target="Field Distribution">
      <data key="d6">1.0</data>
      <data key="d7">The model efficiently approximated the field distribution by learning it from FEA software.</data>
      <data key="d8">approximation,learning</data>
      <data key="d9">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760286427</data>
    </edge>
    <edge source="Model" target="FEA Software">
      <data key="d6">1.0</data>
      <data key="d7">The model learns the field distribution from the FEA software.</data>
      <data key="d8">basis,learning</data>
      <data key="d9">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760286428</data>
    </edge>
    <edge source="Model" target="GPUs">
      <data key="d6">1.0</data>
      <data key="d7">The model has the added advantage of parallelizability over GPUs.</data>
      <data key="d8">advantage,parallelizability</data>
      <data key="d9">chunk-6d4389bce8e015dd342452266c2e8a65</data>
