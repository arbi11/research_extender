      <data key="d2">A diagram illustrating the architecture of a feedforward neural network with two hidden layers.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289254</data>
    </node>
    <node id="Hidden Layer #1">
      <data key="d0">Hidden Layer #1</data>
      <data key="d1">concept</data>
      <data key="d2">Hidden Layer #1 is a layer within the neural network diagram, located to the right of the Input Layer and enclosed in a light blue rounded rectangle, containing four circular nodes labeled 'H₁₁' through 'H₁₄'.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289255</data>
    </node>
    <node id="Hidden Layer #2">
