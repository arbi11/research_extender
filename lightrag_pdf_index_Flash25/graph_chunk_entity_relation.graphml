    <node id="Q (s, a, w)">
      <data key="d0">Q (s, a, w)</data>
      <data key="d1">concept</data>
      <data key="d2">Q (s, a, w) represents an approximation of the action-value function, parameterized by w, in a reinforcement learning context.</data>
      <data key="d3">chunk-85055739dbffbeba952630d321118334</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1760292948</data>
