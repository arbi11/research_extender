      <data key="d0">SOFT LEFT</data>
      <data key="d1">concept</data>
      <data key="d2">SOFT LEFT is one of the eight possible actions, specifically labeled for action a₃.</data>
      <data key="d3">chunk-66f8a9943508aa952a9845858b8d3374</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289201</data>
