      <data key="d5">1760286753</data>
    </node>
    <node id="Function">
      <data key="d0">Function</data>
      <data key="d3">chunk-9360ea49ebcfafb62140f053dfc1f70c</data>
      <data key="d2">The learning algorithm uses its own estimate of the value function to update its prediction, adjusting weights (w) of the neural network predicting the action-value function Q(s,a). This is determined by the gradient of the loss function (Eq. 5.1).</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760286753</data>
    </node>
