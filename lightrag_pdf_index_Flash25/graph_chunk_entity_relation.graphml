      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289405</data>
    </node>
    <node id="Q(s, a_2)">
      <data key="d0">Q(s, a_2)</data>
      <data key="d1">data</data>
      <data key="d2">Q(s, a_2) represents a Q-value for a specific state-action pair, corresponding to the action 'DOWN'.</data>
      <data key="d3">chunk-11cc1c9381d2b807e25d94ba609ca1ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289405</data>
    </node>
    <node id="Q(s, a_3)">
      <data key="d0">Q(s, a_3)</data>
      <data key="d1">data</data>
      <data key="d2">Q(s, a_3) represents a Q-value for a specific state-action pair, corresponding to the action 'LEFT'.</data>
      <data key="d3">chunk-11cc1c9381d2b807e25d94ba609ca1ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
