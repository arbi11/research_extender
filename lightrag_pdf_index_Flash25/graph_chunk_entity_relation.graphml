      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760290742</data>
    </edge>
    <edge source="Stochastic Policy" target="Parameters Theta">
      <data key="d6">1.0</data>
      <data key="d7">The stochastic policy is parameterized by theta, which are adjusted during learning.</data>
      <data key="d8">learning,parameterization</data>
      <data key="d9">chunk-b470eacdde6ba3189132ab26e9634120</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760290743</data>
    </edge>
    <edge source="Stochastic Policy" target="Greedy Policies">
      <data key="d6">1.0</data>
      <data key="d7">The stochastic policy assigns probabilities to actions, unlike greedy policies that always select the action with the highest value.</data>
