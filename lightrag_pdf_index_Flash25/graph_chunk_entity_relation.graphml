      <data key="d11">1760289753</data>
    </edge>
    <edge source="Monte Carlo Methods" target="Return ($G_t$)">
      <data key="d6">1.0</data>
      <data key="d7">Monte Carlo methods use the true realized return ($G_t$) to update the value function.</data>
