      <data key="d11">1760289672</data>
    </edge>
    <edge source="Advantage" target="Value Function V(s)">
      <data key="d6">1.0</data>
      <data key="d7">The Advantage function is defined by subtracting the Value Function $V(s)$ from $Q(s,a)$.</data>
      <data key="d8">calculation,component of</data>
      <data key="d9">chunk-2e3e1dd6f2a21d7997b5fa281b76b709</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760287153</data>
    </edge>
    <edge source="Advantage" target="Advantage Actor-Critic">
      <data key="d6">1.0</data>
      <data key="d7">Advantage Actor-Critic algorithms replace the Q-value with 'Advantage' as a performance metric.</data>
      <data key="d8">core concept,utilization</data>
      <data key="d9">chunk-2e3e1dd6f2a21d7997b5fa281b76b709</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760287154</data>
    </edge>
    <edge source="Advantage" target="Q-Value">
      <data key="d6">1.0</data>
      <data key="d7">Advantage is defined by subtracting the State's Value function from the Q-value.</data>
      <data key="d8">comparison,derivation</data>
      <data key="d9">chunk-2e3e1dd6f2a21d7997b5fa281b76b709</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760287157</data>
    </edge>
    <edge source="Advantage" target="Mnih et al. 2016">
      <data key="d6">1.0</data>
      <data key="d7">The Advantage function's indication to the agent is described in a publication by Mnih et al. 2016.</data>
      <data key="d8">definition,reference</data>
      <data key="d9">chunk-2e3e1dd6f2a21d7997b5fa281b76b709</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760287157</data>
    </edge>
    <edge source="Value Function V(s)" target="Equation 5.16">
      <data key="d6">1.0</data>
      <data key="d7">Equation 5.16 references the state's Value function.</data>
      <data key="d8">context,reference</data>
      <data key="d9">chunk-3cc8202063f67533ab2523d99cadd60f</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760287254</data>
    </edge>
    <edge source="Value Function V(s)" target="Equation 4.3">
      <data key="d6">1.0</data>
      <data key="d7">The Value Function V(s) can be updated in a similar fashion as mentioned for Equation 4.3.</data>
      <data key="d8">relationship,update mechanism</data>
      <data key="d9">chunk-87755691ed2aadfe9652dad2d067f4a9</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760291601</data>
    </edge>
