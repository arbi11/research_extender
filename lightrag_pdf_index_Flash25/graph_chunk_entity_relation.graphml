      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289114</data>
    </node>
    <node id="Grid-based Design Space">
      <data key="d0">Grid-based Design Space</data>
      <data key="d1">concept</data>
      <data key="d2">The Grid-based Design Space is the framework within which the C-core controller is set up, implying a method for spatial design and optimization.</data>
      <data key="d3">chunk-31fcb301590d668517d7e9583a508d90</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289114</data>
    </node>
