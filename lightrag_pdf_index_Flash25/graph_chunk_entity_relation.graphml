    <node id="Motor Control Strategies">
      <data key="d0">Motor Control Strategies</data>
      <data key="d1">method</data>
      <data key="d2">Motor control strategies are solved to find optimal excitation conditions for every speed during the calculation of performance maps.</data>
      <data key="d3">chunk-679159f51a7b3c245fdff9193fd1ef89</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285485</data>
