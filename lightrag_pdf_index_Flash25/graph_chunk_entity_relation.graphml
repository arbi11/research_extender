      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760291901</data>
    </node>
    <node id="$\nabla l o g ( \pi ( a _ { t } | s _ { t } ; \boldsymbol { \theta } ) )$">
      <data key="d0">$\nabla l o g ( \pi ( a _ { t } | s _ { t } ; \boldsymbol { \theta } ) )$</data>
      <data key="d3">chunk-890e76382b57a11ba9855a8134986055</data>
      <data key="d2">$\nabla_{\boldsymbol{\theta}} J$ is proportional to the gradient of the logarithm of the policy's probability.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760292225</data>
    </node>
    <node id="J($\boldsymbol{\theta}$)">
      <data key="d0">J($\boldsymbol{\theta}$)</data>
      <data key="d3">chunk-890e76382b57a11ba9855a8134986055</data>
      <data key="d2">The equation provides a method to perform gradient ascent on J($\boldsymbol{\theta}$).</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760292233</data>
    </node>
    <node id="Score Function">
      <data key="d0">Score Function</data>
      <data key="d3">chunk-890e76382b57a11ba9855a8134986055</data>
      <data key="d2">Nabla Log Policy is often called the 'score function'.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760292235</data>
    </node>
