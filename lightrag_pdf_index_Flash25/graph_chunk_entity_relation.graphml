      <data key="d0">Efficiency Map To Power Factor Map</data>
      <data key="d1">concept</data>
      <data key="d2">This represents the specific task or mapping being performed in the learning methodologies described.</data>
      <data key="d3">chunk-248a0b72513cd485685d4b3e3864e01e</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289384</data>
    </node>
    <node id="IPM To IPM">
      <data key="d0">IPM To IPM</data>
      <data key="d1">concept</data>
      <data key="d2">IPM to IPM refers to a mapping task (Internal Permanent Magnet) relevant to the context of the training curves.</data>
      <data key="d3">chunk-248a0b72513cd485685d4b3e3864e01e</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289385</data>
    </node>
