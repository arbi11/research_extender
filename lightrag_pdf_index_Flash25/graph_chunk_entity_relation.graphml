      <data key="d0">Finite Element Simulation</data>
      <data key="d1">method</data>
      <data key="d2">Finite Element Simulation is a numerical method used to analyze the magnetic field distribution within the SynRM.</data>
      <data key="d3">chunk-b56c95146eb3d0e8591ffefd6ab679ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289045</data>
    </node>
    <node id="Discretized Synchronous Reluctance Motor (SynRM)">
      <data key="d0">Discretized Synchronous Reluctance Motor (SynRM)</data>
      <data key="d1">artifact</data>
      <data key="d2">A Discretized Synchronous Reluctance Motor (SynRM) is a type of motor whose design is based on a segmented or gridded structure, specifically a 5x5 design space in this context.</data>
      <data key="d3">chunk-b56c95146eb3d0e8591ffefd6ab679ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289046</data>
    </node>
    <node id="Salient Poles">
      <data key="d0">Salient Poles</data>
      <data key="d1">concept</data>
      <data key="d2">Salient Poles are protruding sections of the SynRM rotor designed for optimal performance.</data>
      <data key="d3">chunk-b56c95146eb3d0e8591ffefd6ab679ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289046</data>
    </node>
    <node id="Tesla">
      <data key="d0">Tesla</data>
      <data key="d1">concept</data>
      <data key="d2">Tesla is the unit of measurement for magnetic flux density, indicated in the legend of Panel (b).</data>
      <data key="d3">chunk-b56c95146eb3d0e8591ffefd6ab679ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289046</data>
