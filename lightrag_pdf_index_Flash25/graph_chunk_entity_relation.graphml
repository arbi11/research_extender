      <data key="d0">Kim et al. 2004</data>
      <data key="d1">content</data>
      <data key="d2">A reference for a study by Kim et al. published in 2004, included in the table's "Ref" column.</data>
      <data key="d3">chunk-d146c06d89d470b7db435c475826c0e7</data>
