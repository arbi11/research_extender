      <data key="d5">1760289255</data>
    </node>
    <node id="I₂">
      <data key="d0">I₂</data>
      <data key="d1">concept</data>
      <data key="d2">I₂ is a circular node within the Input Layer, representing an input feature.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289255</data>
    </node>
    <node id="I₃">
      <data key="d0">I₃</data>
      <data key="d1">concept</data>
      <data key="d2">I₃ is a circular node within the Input Layer, representing an input feature.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289255</data>
    </node>
    <node id="H₁₁">
      <data key="d0">H₁₁</data>
      <data key="d1">concept</data>
      <data key="d2">H₁₁ is a circular node within Hidden Layer #1.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289256</data>
    </node>
    <node id="H₁₂">
      <data key="d0">H₁₂</data>
      <data key="d1">concept</data>
      <data key="d2">H₁₂ is a circular node within Hidden Layer #1.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289256</data>
    </node>
