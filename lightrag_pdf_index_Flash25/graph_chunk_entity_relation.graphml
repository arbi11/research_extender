    <node id="Electromagnetic Performance Characteristics">
      <data key="d0">Electromagnetic Performance Characteristics</data>
      <data key="d1">concept</data>
      <data key="d2">Electromagnetic performance characteristics include electromagnetic force, torque, fields, and losses distribution maps, evaluated by an electromagnetic model.</data>
      <data key="d3">chunk-75365c11d58d9301541e75f2ba5f03ec</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
