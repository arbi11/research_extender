      <data key="d9">chunk-2ceb1ac6e54fec53c601d8b38f2b338d</data>
      <data key="d10">F:\From_D_drive\Code\research_extender\thesis_pdf\Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760290351</data>
    </edge>
    <edge source="Q-Value" target="Advantage Function">
      <data key="d6">1.0</data>
      <data key="d7">The Advantage function is a refinement of the Q-value, specifically defined as $A(s, a) = Q(s, a) - V(s)$.</data>
      <data key="d8">refinement,relationship</data>
      <data key="d9">chunk-22c061c45c3a0d2579ced8d3121f0d90</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760290703</data>
    </edge>
