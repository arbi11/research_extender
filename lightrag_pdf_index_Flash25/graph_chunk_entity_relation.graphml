    <node id="DL Method">
      <data key="d0">DL Method</data>
      <data key="d1">method</data>
      <data key="d2">Deep Learning method, a subset of ML, used in Zhang et al. 2019 for topology optimization.</data>
      <data key="d3">chunk-d519cd75c14207ceeaef0cf84051a1d1</data>
