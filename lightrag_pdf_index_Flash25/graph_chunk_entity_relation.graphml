      <data key="d2">Variational Inference learns an approximate distribution Q(W).</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760286988</data>
    </node>
