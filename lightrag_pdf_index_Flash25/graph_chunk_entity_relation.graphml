      <data key="d1">concept</data>
      <data key="d2">Geometric features are among the types of information used to predict magnetic field distribution.</data>
      <data key="d3">chunk-e320c3afc0456b527186e2755a2ac4af</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285548</data>
    </node>
    <node id="Excitations">
      <data key="d0">Excitations</data>
      <data key="d1">concept</data>
      <data key="d2">Excitations are among the types of information used to predict magnetic field distribution.</data>
      <data key="d3">chunk-e320c3afc0456b527186e2755a2ac4af</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
