    </edge>
    <edge source="Output Map" target="Non-Dilated Filter with Padding">
      <data key="d6">1.0</data>
      <data key="d7">The non-dilated filter generates a single output value for the output map from a local neighborhood of the input.</data>
      <data key="d8">generation,transformation</data>
