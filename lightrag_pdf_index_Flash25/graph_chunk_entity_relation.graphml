      <data key="d11">1760292308</data>
    </edge>
    <edge source="Comparison Of Training Curves" target="Efficiency Map To Power Factor Map">
      <data key="d6">1.0</data>
      <data key="d7">The comparison of training curves is specifically for the task of mapping 'Efficiency map to Power factor map'.</data>
