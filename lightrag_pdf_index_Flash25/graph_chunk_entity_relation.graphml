      <data key="d3">chunk-66f8a9943508aa952a9845858b8d3374</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289202</data>
    </node>
    <node id="DOWN">
      <data key="d0">DOWN</data>
      <data key="d1">concept</data>
      <data key="d2">DOWN is one of the eight possible actions, specifically labeled for action a₆.</data>
      <data key="d3">chunk-66f8a9943508aa952a9845858b8d3374</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289202</data>
    </node>
    <node id="LEFT">
      <data key="d0">LEFT</data>
      <data key="d1">concept</data>
      <data key="d2">LEFT is one of the eight possible actions, specifically labeled for action a₇.</data>
      <data key="d3">chunk-66f8a9943508aa952a9845858b8d3374</data>
