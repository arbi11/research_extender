    <node id="Gradient of Log Policy">
      <data key="d0">Gradient of Log Policy</data>
      <data key="d1">concept</data>
      <data key="d2">∇_θ [ln π(a_t | s_t; θ_t)] represents the gradient of the logarithm of the policy, indicating the direction of parameter adjustment.</data>
