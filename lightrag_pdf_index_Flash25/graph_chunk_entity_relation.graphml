      <data key="d11">1760292064</data>
    </edge>
    <edge source="Q-Value" target="State (s_t)">
      <data key="d6">1.0</data>
      <data key="d7">The Q-value function is evaluated for a specific state s_t.</data>
      <data key="d8">dependence,evaluation</data>
      <data key="d9">chunk-4a8823695e17798553515e243bdbfda2</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1760292793</data>
    </edge>
    <edge source="Q-Value" target="Action (a_t)">
      <data key="d6">1.0</data>
      <data key="d7">The Q-value function is evaluated for a specific action a_t.</data>
      <data key="d8">dependence,evaluation</data>
      <data key="d9">chunk-4a8823695e17798553515e243bdbfda2</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1760292794</data>
    </edge>
    <edge source="Q-Value" target="Bellman Equation">
      <data key="d6">1.0</data>
      <data key="d7">The Bellman Equation provides a specific update rule for the Q-value, incorporating future rewards.</data>
      <data key="d8">methodology,update rule</data>
      <data key="d9">chunk-4a8823695e17798553515e243bdbfda2</data>
      <data key="d10">unknown_source</data>
