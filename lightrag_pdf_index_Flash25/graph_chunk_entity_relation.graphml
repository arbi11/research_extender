    <node id="Chapter 1">
      <data key="d0">Chapter 1</data>
      <data key="d1">content</data>
      <data key="d2">Chapter 1 of the thesis serves as an introduction and outlines the vision for advancing high-fidelity analysis in electric machine development.</data>
      <data key="d3">chunk-8f5af4d3dcb1894cb22db778a1e1b744</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
