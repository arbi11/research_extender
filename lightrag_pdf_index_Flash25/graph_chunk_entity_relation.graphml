    <node id="TO Methodology">
      <data key="d0">TO Methodology</data>
      <data key="d1">method</data>
      <data key="d2">The TO (Topology Optimization) methodology discussed in this chapter will be extended to Chapter 5 for generalizing to unseen design problems.</data>
      <data key="d3">chunk-51ad9a81904dfb8134371112a0be9fa9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285616</data>
