    </node>
    <node id="Evaluations">
      <data key="d0">Evaluations</data>
      <data key="d1">data</data>
      <data key="d2">Evaluations are assessments of model performance, typically based on ground truth and labels in statistical learning.</data>
      <data key="d3">chunk-75365c11d58d9301541e75f2ba5f03ec</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
