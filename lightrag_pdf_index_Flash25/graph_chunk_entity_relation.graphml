      <data key="d1">method</data>
      <data key="d2">Describes the movement of a 3x3 controller within a specified design domain.</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285250</data>
    </node>
    <node id="State Transition (st, at, st+1)">
      <data key="d0">State Transition (st, at, st+1)</data>
      <data key="d1">concept</data>
      <data key="d2">A concept describing the transition from one state (st) to another (st+1) via an action (at).</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285250</data>
    </node>
    <node id="Discrete Design Domain with |B|_airgap as the State Space">
      <data key="d0">Discrete Design Domain with |B|_airgap as the State Space</data>
      <data key="d1">concept</data>
      <data key="d2">A discrete design domain where the magnetic field magnitude in the air gap (|B|_airgap) is considered the state space.</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285250</data>
    </node>
    <node id="Discrete Design Domain along with |B| in the Design Space as the State Space">
      <data key="d0">Discrete Design Domain along with |B| in the Design Space as the State Space</data>
      <data key="d1">concept</data>
      <data key="d2">A discrete design domain where the magnetic field magnitude (|B|) within the design space is considered the state space.</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285250</data>
    </node>
    <node id="Possibility of a Design Error">
      <data key="d0">Possibility of a Design Error</data>
      <data key="d1">concept</data>
      <data key="d2">The potential for an error in design due to the controller moving out of the designated design space.</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
