    <edge source="Critic" target="Learning Element">
      <data key="d6">1.0</data>
      <data key="d7">The Critic sends an arrow to the Learning Element, providing feedback.</data>
      <data key="d8">feedback,guidance</data>
      <data key="d9">chunk-d9b48425c0c345b3be14ed824c6579b7</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760292152</data>
    </edge>
    <edge source="Critic" target="Input">
      <data key="d6">1.0</data>
      <data key="d7">The Input node sends data to the Critic node.</data>
      <data key="d8">data flow,sends data</data>
      <data key="d9">chunk-d9b48425c0c345b3be14ed824c6579b7</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760292157</data>
    </edge>
    <edge source="Critic" target="AGENT">
      <data key="d6">1.0</data>
      <data key="d7">The Critic node is contained within the AGENT.</data>
      <data key="d8">component,internal process</data>
