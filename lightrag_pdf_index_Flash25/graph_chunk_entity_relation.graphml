      <data key="d1">concept</data>
      <data key="d2">Q_beh(s_t, a_t, w_beh) represents the behavioral Q-value at state s_t and action a_t, parameterized by behavioral weights w_beh.</data>
      <data key="d3">chunk-0fb650db56653b515d55eb1ef7514257</data>
      <data key="d4">unknown_source</data>
