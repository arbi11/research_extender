      <data key="d11">1760286430</data>
    </edge>
    <edge source="Model" target="Computational Costs">
      <data key="d6">1.0</data>
      <data key="d7">The model enables lower computational costs when generating field distribution for new geometries.</data>
      <data key="d8">efficiency,reduction</data>
      <data key="d9">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760286441</data>
    </edge>
    <edge source="Model" target="New Geometries">
      <data key="d6">1.0</data>
      <data key="d7">The model can generate field distribution for new geometries.</data>
      <data key="d8">application,generation</data>
      <data key="d9">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760286443</data>
    </edge>
    <edge source="Model" target="Figure 3.12">
      <data key="d6">1.0</data>
      <data key="d7">The prediction from the model illustrated in Figure 3.8 is shown in Figure 3.12.</data>
