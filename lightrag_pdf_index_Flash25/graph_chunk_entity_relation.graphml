    <node id="Rri">
      <data key="d0">Rri</data>
      <data key="d1">data</data>
      <data key="d2">Rri is a labeled parameter indicating an inner radius, connected by a grey horizontal line to an inner grey circle below the origin.</data>
      <data key="d3">chunk-f476972defaf212918b90b259aa69f03</data>
