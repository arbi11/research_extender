      <data key="d9">chunk-70c2a865bc92e157d3426a926d7ddd22</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760291926</data>
    </edge>
    <edge source="Q-value Function" target="Q-Learning Temporal-Difference Update Rule">
      <data key="d6">1.0</data>
      <data key="d7">The Q-value function, Q(s_t, a_t), is iteratively estimated and updated by the Q-Learning Temporal-Difference Update Rule.</data>
