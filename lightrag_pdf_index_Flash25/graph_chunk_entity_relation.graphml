      <data key="d2">0.15X7 is a labeled parameter indicating a specific radial distance, connected to a segment by a grey horizontal line.</data>
      <data key="d3">chunk-f476972defaf212918b90b259aa69f03</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760288810</data>
    </node>
    <node id="Stator Winding Slots">
      <data key="d0">Stator Winding Slots</data>
      <data key="d1">artifact</data>
      <data key="d2">Stator winding slots are components within the motor, colored light orange-brown, featuring a rectangular shape with rounded edges, visible along the outer circumference.</data>
      <data key="d3">chunk-f476972defaf212918b90b259aa69f03</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
