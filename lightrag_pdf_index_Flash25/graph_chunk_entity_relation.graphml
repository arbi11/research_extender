      <data key="d11">1760291437</data>
    </edge>
    <edge source="TD-Learning" target="Action Value Function Q(S,A)">
      <data key="d6">2.0</data>
      <data key="d7">TD-learning updates the value of one state (Q(st,at)) towards its own estimate of the value in the next state.&lt;SEP&gt;TD-learning uses the value associated with each state-action pair (Q(s,a)) to utilize experience.</data>
      <data key="d8">improvement,update,update target,utilization</data>
      <data key="d9">chunk-c28d95920dc2d89112c02d6c86f6d7e2</data>
