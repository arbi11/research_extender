      <data key="d0">3D Cartesian Coordinate System</data>
      <data key="d1">method</data>
      <data key="d2">A small 3D Cartesian coordinate system with 'X' and 'Y' axes labeled, and an implied 'Z' axis, suggesting a potential 3D context for the system.</data>
      <data key="d3">chunk-31fcb301590d668517d7e9583a508d90</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289114</data>
