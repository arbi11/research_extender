    <node id="K=64">
      <data key="d0">K=64</data>
      <data key="d1">data</data>
      <data key="d2">K=64 represents the number of kernels/filters in a convolutional layer.</data>
      <data key="d3">chunk-38ad7ba535a3b44f510acc91b0e8d5f1</data>
