      <data key="d11">1760290078</data>
    </edge>
    <edge source="Dropout" target="Bayesian Network">
      <data key="d6">1.0</data>
      <data key="d7">Dropout is seen as an approximation to a Bayesian Network.</data>
      <data key="d8">approximation,interpretation</data>
