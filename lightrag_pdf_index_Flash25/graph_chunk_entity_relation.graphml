      <data key="d3">chunk-258e29a004ed4a9ecd38f72b2c0d91d8</data>
      <data key="d2">The Q-learning update rule provides the Q-values that an $\epsilon$-greedy policy uses to select actions.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760292265</data>
    </node>
    <node id="$Q_t(s, a)$">
      <data key="d0">$Q_t(s, a)$</data>
      <data key="d3">chunk-dbd39005d698bcd623fe368243dbe14d</data>
      <data key="d2">$Q_t(s, a)$ represents the action-value function at a specific time step $t$.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760292302</data>
    </node>
