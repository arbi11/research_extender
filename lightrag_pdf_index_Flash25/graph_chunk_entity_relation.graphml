    <node id="Iron (pi=1)">
      <data key="d0">Iron (pi=1)</data>
      <data key="d1">concept</data>
      <data key="d2">Iron (pi=1) represents a material state within the discretized design cells, indicating a magnetic material.</data>
      <data key="d3">chunk-02e55225b1f173db3033115aeae970db</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760288971</data>
    </node>
    <node id="Air (pi=0)">
      <data key="d0">Air (pi=0)</data>
      <data key="d1">concept</data>
      <data key="d2">Air (pi=0) represents a material state within the discretized design cells, indicating a non-magnetic material or void.</data>
      <data key="d3">chunk-02e55225b1f173db3033115aeae970db</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760288971</data>
