      <data key="d0">Flux Sources</data>
      <data key="d1">concept</data>
      <data key="d2">Flux sources are one of the three types of elements appearing in Magnetic Equivalent Circuits.</data>
      <data key="d3">chunk-05d9b6a613299c6224fd2160377cbc33</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285655</data>
    </node>
    <node id="Permeance">
      <data key="d0">Permeance</data>
      <data key="d1">concept</data>
