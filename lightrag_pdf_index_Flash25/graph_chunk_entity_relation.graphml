      <data key="d0">Section 2.5</data>
      <data key="d1">content</data>
      <data key="d2">Section 2.5 covers a discussion on simple Feedforward Neural Networks.</data>
      <data key="d3">chunk-31f3b0d30beebae149e306398e8c2b1b</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
