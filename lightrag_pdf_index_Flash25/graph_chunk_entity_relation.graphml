      <data key="d0">On-Off TO Methodology</data>
      <data key="d1">method</data>
      <data key="d2">The methodology on which the GA algorithm operates.</data>
      <data key="d3">chunk-3cc8202063f67533ab2523d99cadd60f</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760286007</data>
