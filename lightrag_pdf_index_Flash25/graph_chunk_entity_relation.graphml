      <data key="d11">1760292363</data>
    </edge>
    <edge source="Predictive Distribution" target="Bayesian Neural Network">
      <data key="d6">1.0</data>
      <data key="d7">The provided equation represents the predictive distribution in a Bayesian neural network setting.</data>
      <data key="d8">application,context</data>
      <data key="d9">chunk-da0a01577276faacfde89d458d90e662</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760292373</data>
    </edge>
    <edge source="Predictive Distribution" target="Model Parameters">
      <data key="d6">1.0</data>
      <data key="d7">The predictive distribution accounts for the uncertainty in the model's parameters ($W$).</data>
      <data key="d8">dependency,involvement</data>
      <data key="d9">chunk-da0a01577276faacfde89d458d90e662</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760292374</data>
    </edge>
    <edge source="Predictive Distribution" target="New Output ($y$)">
      <data key="d6">1.0</data>
      <data key="d7">The predictive distribution is concerned with the marginal likelihood of observing a new output $y$.</data>
      <data key="d8">prediction target,variable</data>
      <data key="d9">chunk-da0a01577276faacfde89d458d90e662</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760292374</data>
    </edge>
    <edge source="Predictive Distribution" target="New Input ($x$)">
      <data key="d6">1.0</data>
      <data key="d7">The predictive distribution is concerned with the marginal likelihood of observing $y$ given a new input $x$.</data>
      <data key="d8">prediction condition,variable</data>
