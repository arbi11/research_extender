      <data key="d2">Hemp 1958 is cited for work focused on the optimal layout design of trusses.</data>
      <data key="d3">chunk-6f3d168f1b6a8020e0606ef52cd19390</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285888</data>
    </node>
    <node id="Prager and Taylor 1968">
