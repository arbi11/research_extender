    <node id="Optimized Geometry's Magnetic Field Distribution">
      <data key="d0">Optimized Geometry's Magnetic Field Distribution</data>
      <data key="d1">concept</data>
      <data key="d2">Refers to the magnetic field distribution of a geometry that has been optimized.&lt;SEP&gt;This is the primary subject of the visualization, focusing on how magnetic fields are spread in a specially designed shape.</data>
      <data key="d3">chunk-d8330ecbeee1c4ebe7ea64bfd7fbb45b&lt;SEP&gt;chunk-4124ebf92b84af2f8bbaecff99882b47</data>
