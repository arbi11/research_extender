      <data key="d5">1760289082</data>
    </node>
    <node id="DL Emulator">
      <data key="d0">DL Emulator</data>
      <data key="d1">concept</data>
      <data key="d2">A DL emulator is an ML network trained in a supervised manner that can predict solutions for arbitrary input but lacks physics-based judgment.&lt;SEP&gt;A DL emulator lacks physics-based judgment. This is an important issue that will be addressed.</data>
      <data key="d3">chunk-03395909e238b7701943add27146739b&lt;SEP&gt;chunk-e320c3afc0456b527186e2755a2ac4af</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285550</data>
    </node>
    <node id="Uncertainty Analysis">
      <data key="d0">Uncertainty Analysis</data>
      <data key="d1">method</data>
      <data key="d2">Uncertainty analysis is a method applied over prediction to generalize the DL estimator and address the issue of lacking physics-based judgment.&lt;SEP&gt;Uncertainty analysis is a method employed to generalize the DL estimator.</data>
      <data key="d3">chunk-03395909e238b7701943add27146739b&lt;SEP&gt;chunk-e320c3afc0456b527186e2755a2ac4af</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285550</data>
    </node>
