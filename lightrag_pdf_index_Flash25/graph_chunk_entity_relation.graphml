    <node id="First Principle Models">
      <data key="d0">First Principle Models</data>
      <data key="d1">method</data>
      <data key="d2">First Principle models are built on solving physics, such as Maxwell's equations.&lt;SEP&gt;First Principle Models use a bottom-up approach to understand the relationship between input parameters and output characteristics, often leading to repetitive processes.</data>
      <data key="d3">chunk-74285f9f1c2db4a1aaef011e90f166c0&lt;SEP&gt;chunk-05d9b6a613299c6224fd2160377cbc33</data>
