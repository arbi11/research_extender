      <data key="d0">MAGNET V2020</data>
      <data key="d1">software</data>
      <data key="d2">MAGNET V2020.2 is a specific software version used for Finite Element Analysis in the thesis.</data>
      <data key="d3">chunk-75365c11d58d9301541e75f2ba5f03ec</data>
