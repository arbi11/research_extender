    <node id="Shaded Plot |B| Smoothed">
      <data key="d0">Shaded Plot |B| Smoothed</data>
      <data key="d1">concept</data>
      <data key="d2">This is a legend indicating that the image uses a shaded plot to visualize the smoothed magnitude of the magnetic field (|B|).</data>
