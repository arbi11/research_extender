    <edge source="Temporal Difference Learning" target="Sutton and Barto 2018">
      <data key="d6">1.0</data>
      <data key="d7">Temporal Difference Learning is supported by concepts described in Sutton and Barto 2018 under Reinforcement Learning.</data>
      <data key="d8">reference,related concept</data>
