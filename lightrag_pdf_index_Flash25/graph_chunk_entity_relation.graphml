      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285649</data>
    </node>
    <node id="Finite Element Model Data">
      <data key="d0">Finite Element Model Data</data>
      <data key="d1">data</data>
      <data key="d2">Finite Element Model (FE) Data is used to develop models for predicting the performance of electric machines.</data>
