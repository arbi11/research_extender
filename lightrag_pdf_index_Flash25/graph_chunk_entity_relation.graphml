      <data key="d0">Network and Training Partition Features</data>
      <data key="d1">data</data>
      <data key="d2">Network and Training Partition Features are characteristics of network and training partitions, listed in Table 2.4.</data>
      <data key="d3">chunk-f0a87e071d0b56bc121b18a65c5875d0</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285512</data>
    </node>
