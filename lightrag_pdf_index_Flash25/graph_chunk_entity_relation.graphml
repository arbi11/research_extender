      <data key="d1">data</data>
      <data key="d2">The field estimated by the model, which can be used for post-processing or reverting to other numerical solvers.</data>
      <data key="d3">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285431</data>
    </node>
    <node id="Numerical Solvers">
