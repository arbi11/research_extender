      <data key="d1">content</data>
      <data key="d2">Figure 2.6 is an image presenting an Artificial/Feedforward Neural Network with 2 hidden layers.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289254</data>
    </node>
