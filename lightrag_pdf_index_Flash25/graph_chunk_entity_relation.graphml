      <data key="d0">Em Actuator</data>
      <data key="d1">artifact</data>
      <data key="d2">An electromagnetic actuator whose core is optimized using the Genetic Algorithm and SeqTO-v1 methodology to maximize the force experienced by its armature.</data>
      <data key="d3">chunk-51ad9a81904dfb8134371112a0be9fa9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285619</data>
