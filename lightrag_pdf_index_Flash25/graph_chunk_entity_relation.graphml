      <data key="d3">chunk-b56c95146eb3d0e8591ffefd6ab679ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289044</data>
    </node>
    <node id="Flux Paths">
      <data key="d0">Flux Paths</data>
      <data key="d1">concept</data>
      <data key="d2">Flux Paths are indicated by thin black contour lines in panel (b), showing the flow of magnetic flux within the SynRM.</data>
      <data key="d3">chunk-b56c95146eb3d0e8591ffefd6ab679ea</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289045</data>
    </node>
