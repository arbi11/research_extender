      <data key="d1">image</data>
      <data key="d2">```json
{
    "detailed_description": "The image displays a V-model diagram illustrating the 'V-Desi...</data>
      <data key="d3">chunk-c0af18e12848c44ab0d9b01471789474</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
