      <data key="d0">H₁₃</data>
      <data key="d1">concept</data>
      <data key="d2">H₁₃ is a circular node within Hidden Layer #1.</data>
      <data key="d3">chunk-ca632ae39508b7c6fdf1ad04973857b9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289256</data>
    </node>
