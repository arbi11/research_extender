    <edge source="Optimization Problem" target="Eqn. 4.2">
      <data key="d6">1.0</data>
      <data key="d7">The optimization problem is formulated in Eqn. 4.2.</data>
      <data key="d8">formulation,representation</data>
      <data key="d9">chunk-c9268a7feb5bb249a1838bc7743ffa61</data>
