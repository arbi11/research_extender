      <data key="d0">Topology Optimization Tasks</data>
      <data key="d1">concept</data>
      <data key="d2">Topology Optimization Tasks are a type of design optimization problem where the agent displays generalizability.</data>
      <data key="d3">chunk-8f5af4d3dcb1894cb22db778a1e1b744</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
