      <data key="d2">The L-shaped structure is formed by blue squares in the geometry panels.</data>
      <data key="d3">chunk-a11edf0b881aae28423c1b0d33893b2d</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289204</data>
    </node>
    <node id="Thick, Solid Blue Bar">
      <data key="d0">Thick, Solid Blue Bar</data>
