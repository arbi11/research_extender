    <node id="Section 2.4">
      <data key="d0">Section 2.4</data>
      <data key="d1">content</data>
      <data key="d2">Section 2.4 mentions the limits on geometrical and excitation parameters.</data>
      <data key="d3">chunk-31f3b0d30beebae149e306398e8c2b1b</data>
