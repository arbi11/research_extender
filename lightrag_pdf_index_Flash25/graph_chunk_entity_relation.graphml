      <data key="d2">A factor contributing to the increase in GHG emissions in the transportation sector.</data>
      <data key="d3">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285436</data>
    </node>
