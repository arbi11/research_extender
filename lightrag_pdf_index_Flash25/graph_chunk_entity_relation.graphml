      <data key="d0">Tree Diagram for the Sequence Based Controller</data>
      <data key="d1">concept</data>
      <data key="d2">A visual representation of the sequence-based controller using a tree diagram.</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285250</data>
    </node>
    <node id="Simulated Half Geometry">
      <data key="d0">Simulated Half Geometry</data>
      <data key="d1">concept</data>
      <data key="d2">A method of simulating only half of a geometry due to symmetry.</data>
      <data key="d3">chunk-2fac0a146871deda05d5134b0c361666</data>
