      <data key="d0">SeqTO-VZ</data>
      <data key="d1">method</data>
      <data key="d2">SeqTO-vZ is a future modification of the Sequence based TO methodology, to be introduced in Chapter 5, Section 5.4.</data>
      <data key="d3">chunk-51ad9a81904dfb8134371112a0be9fa9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285624</data>
    </node>
    <node id="Ampere's Circuit Law">
      <data key="d0">Ampere's Circuit Law</data>
      <data key="d1">concept</data>
      <data key="d2">A physical law that describes the magnetic field produced by a current-carrying coil.</data>
      <data key="d3">chunk-51ad9a81904dfb8134371112a0be9fa9</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285624</data>
