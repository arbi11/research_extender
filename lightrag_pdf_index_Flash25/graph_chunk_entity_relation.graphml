      <data key="d0">Simplification</data>
      <data key="d1">concept</data>
      <data key="d2">Simplification is a characteristic of a model, implying it reduces complexity.</data>
      <data key="d3">chunk-75365c11d58d9301541e75f2ba5f03ec</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285299</data>
    </node>
    <node id="Idealization">
      <data key="d0">Idealization</data>
      <data key="d1">concept</data>
      <data key="d2">Idealization is a characteristic of a model, suggesting it presents an ideal version of reality.</data>
      <data key="d3">chunk-75365c11d58d9301541e75f2ba5f03ec</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
