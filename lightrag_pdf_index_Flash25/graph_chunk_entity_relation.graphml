    <edge source="Electromagnetic Problem" target="Nonlinear System of Differential Equations">
      <data key="d6">1.0</data>
      <data key="d7">The system of differential equations for electromagnetic analysis of electric devices is nonlinear due to saturation in magnetic materials.</data>
