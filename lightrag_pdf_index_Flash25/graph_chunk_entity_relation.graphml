      <data key="d0">Electro-Magnetic Torque</data>
      <data key="d1">data</data>
      <data key="d2">Electro-Magnetic Torque is a quantity calculated from converged magnetic vector potentials after finite element analysis for electric motors.</data>
      <data key="d3">chunk-05d9b6a613299c6224fd2160377cbc33</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
