      <data key="d0">Simulation and Design Optimization Tools</data>
      <data key="d1">artifact</data>
      <data key="d2">Tools like FE packages used to analyze multiphysics performances for finding optimal designs.</data>
      <data key="d3">chunk-610e0748724855c847b8fd20690e22db</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760285609</data>
    </node>
