      <data key="d0">Physics-Informed Deep Learning Methods</data>
      <data key="d1">method</data>
      <data key="d2">Physics-informed deep learning methods are an approach for EM analysis that involves solving partial differential equations.</data>
      <data key="d3">chunk-8f5af4d3dcb1894cb22db778a1e1b744</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
