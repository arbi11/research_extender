      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760291657</data>
    </edge>
    <edge source="Hidden Layer" target="Single-Layer Neural Network">
      <data key="d6">1.0</data>
      <data key="d7">A single-layer neural network has no hidden layers.</data>
      <data key="d8">absence,definition</data>
      <data key="d9">chunk-03395909e238b7701943add27146739b</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760286739</data>
    </edge>
    <edge source="Hidden Layer" target="Input Layer">
      <data key="d6">3.0</data>
      <data key="d7">The Input Layer connects to the Hidden Layer, signifying the flow of data for processing.&lt;SEP&gt;The Hidden Layer is connected to the Input Layer by lines representing weighted connections for data flow.&lt;SEP&gt;The Input Layer is connected to the Hidden Layer, facilitating the flow of information.</data>
      <data key="d8">connected_to,connection,data flow,data_flow,information flow</data>
      <data key="d9">chunk-ca632ae39508b7c6fdf1ad04973857b9&lt;SEP&gt;chunk-eb622c9ce0600f3539c3ed7199e0c0ee</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760290311</data>
    </edge>
    <edge source="Hidden Layer" target="Output Layer">
      <data key="d6">3.0</data>
      <data key="d7">The Hidden Layer connects to the Output Layer, indicating the final stage of data processing and result generation.&lt;SEP&gt;The Output Layer is connected to the Hidden Layer by lines representing weighted connections for data flow.&lt;SEP&gt;The Hidden Layer is connected to the Output Layer, passing processed information to the final stage.</data>
      <data key="d8">connected_to,connection,data flow,data_flow,information flow</data>
      <data key="d9">chunk-ca632ae39508b7c6fdf1ad04973857b9&lt;SEP&gt;chunk-eb622c9ce0600f3539c3ed7199e0c0ee</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d11">1760290313</data>
    </edge>
