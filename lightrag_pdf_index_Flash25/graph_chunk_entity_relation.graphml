      <data key="d0">R_t</data>
      <data key="d3">chunk-a24ed737fb6aa8500ccd706bf246c499&lt;SEP&gt;chunk-feffff69e0f56312f2846d9f57d0a4f7</data>
      <data key="d2">R_t represents the immediate reward received at time step t.&lt;SEP&gt;R_t represents the reward received at time step t.</data>
      <data key="d1">concept</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf&lt;SEP&gt;unknown_source</data>
      <data key="d5">1760292889</data>
