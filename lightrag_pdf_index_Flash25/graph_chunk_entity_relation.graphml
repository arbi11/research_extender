      <data key="d1">data</data>
      <data key="d2">Q(s_t+1, a')max represents the maximum Q-value for the next state s_t+1 across all possible actions a'.</data>
      <data key="d3">chunk-ec4e495c59f004fcbe4475de4b2bcbd1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1760293038</data>
