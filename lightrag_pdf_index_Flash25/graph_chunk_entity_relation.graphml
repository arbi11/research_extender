    </edge>
    <edge source="W" target="p(W | X, Y)">
      <data key="d6">1.0</data>
      <data key="d7">p(W | X, Y) represents the posterior probability distribution of W.</data>
      <data key="d8">concept,defines</data>
      <data key="d9">chunk-289a72546a02d10d2aa4147957dfa515</data>
      <data key="d10">Khan_Arbaaz_ECE_Thesis.pdf</data>
