      <data key="d1">organization</data>
      <data key="d2">Entities setting ambitious targets to reduce GHG emissions.</data>
      <data key="d3">chunk-6d4389bce8e015dd342452266c2e8a65</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
