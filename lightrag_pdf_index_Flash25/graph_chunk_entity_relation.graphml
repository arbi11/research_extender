      <data key="d3">chunk-a11edf0b881aae28423c1b0d33893b2d</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289203</data>
    </node>
    <node id="Brick-Red Squares">
      <data key="d0">Brick-Red Squares</data>
      <data key="d1">concept</data>
      <data key="d2">Brick-red squares with circular patterns in the geometry panels denote a winding or coil.</data>
      <data key="d3">chunk-a11edf0b881aae28423c1b0d33893b2d</data>
      <data key="d4">Khan_Arbaaz_ECE_Thesis.pdf</data>
      <data key="d5">1760289204</data>
    </node>
    <node id="L-Shaped Structure">
