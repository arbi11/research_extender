{
 "schema_version": 1,
 "purpose": "New designs assembled only from reusable components, in combinations no official example uses, each checked against a closed-form result. Targets and the 1% tolerance were fixed before any run.",
 "designs": [
  {
   "id": "design-coaxial-capacitor",
   "title": "Coaxial capacitor",
   "source_ids": [
    "electrostaticstutorial",
    "manual5"
   ],
   "source_url": null,
   "purpose": "Conductors on circular contours with a dielectric annulus: a combination no official example uses.",
   "measurements": [
    {
     "id": "inner",
     "op": "conductor",
     "name": "inner"
    }
   ],
   "metrics": [
    {
     "name": "capacitance_F",
     "value": [
      "inner",
      1
     ],
     "divide": [
      "inner",
      0
     ],
     "unit": "F"
    }
   ],
   "targets": [
    {
     "metric": "capacitance_F",
     "value": 3.456641749289633e-11,
     "relative_tolerance": 0.01,
     "kind": "analytic",
     "quote": "C = 2*pi*eps0*L/ln(b/a)",
     "used_for_acceptance": true
    }
   ],
   "article": {
    "parameters": {
     "inner_radius_mm": {
      "value": 1.0,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Inner conductor radius"
     },
     "outer_radius_mm": {
      "value": 5.0,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Outer conductor radius"
     },
     "length_mm": {
      "value": 1000.0,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Out-of-plane length"
     },
     "voltage_V": {
      "value": 1,
      "unit": "V",
      "quote": "Design choice",
      "note": "Inner conductor potential"
     },
     "mesh_divisions": {
      "value": 20,
      "unit": "count",
      "quote": "Design choice",
      "note": "Elements across the gap"
     }
    },
    "assembly": {
     "problem": {
      "physics": "electrostatics",
      "units": "millimeters",
      "type": "planar",
      "depth": "$length_mm"
     },
     "steps": [
      {
       "use": "material",
       "name": "dielectric",
       "values": {
        "ex": 1,
        "ey": 1
       }
      },
      {
       "use": "conductor",
       "name": "inner",
       "value": "$voltage_V"
      },
      {
       "use": "conductor",
       "name": "outer",
       "value": 0
      },
      {
       "use": "circle",
       "radius": "$inner_radius_mm",
       "conductor": "inner"
      },
      {
       "use": "circle",
       "radius": "$outer_radius_mm",
       "conductor": "outer"
      },
      {
       "use": "hole",
       "at": [
        0,
        0
       ]
      },
      {
       "use": "block_label",
       "at": [
        0,
        "=(inner_radius_mm+outer_radius_mm)/2"
       ],
       "material": "dielectric",
       "mesh": "=(outer_radius_mm-inner_radius_mm)/mesh_divisions"
      }
     ]
    }
   }
  },
  {
   "id": "design-twin-lead-open",
   "title": "Twin-lead line in open space",
   "source_ids": [
    "electrostaticstutorial",
    "femm-qt-source-06oct2026"
   ],
   "source_url": null,
   "purpose": "The open boundary builder applied to planar electrostatics, with two conductors at opposite potentials.",
   "measurements": [
    {
     "id": "plus",
     "op": "conductor",
     "name": "plus"
    },
    {
     "id": "minus",
     "op": "conductor",
     "name": "minus"
    }
   ],
   "metrics": [
    {
     "name": "capacitance_per_m_F",
     "value": [
      "plus",
      1
     ],
     "scale": 0.5,
     "unit": "F/m"
    }
   ],
   "targets": [
    {
     "metric": "capacitance_per_m_F",
     "value": 1.578005729619711e-11,
     "relative_tolerance": 0.01,
     "kind": "analytic",
     "quote": "C' = pi*eps0/acosh(d/(2a))",
     "used_for_acceptance": true
    }
   ],
   "article": {
    "parameters": {
     "wire_radius_mm": {
      "value": 1.0,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Wire radius"
     },
     "center_distance_mm": {
      "value": 6.0,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Center-to-center distance"
     },
     "boundary_radius_mm": {
      "value": 15.0,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Open-boundary radius"
     },
     "voltage_V": {
      "value": 1,
      "unit": "V",
      "quote": "Design choice",
      "note": "Each wire is at plus or minus this potential"
     },
     "air_mesh_mm": {
      "value": 0.25,
      "unit": "mm",
      "quote": "Design choice",
      "note": "Air element size"
     },
     "depth_mm": {
      "value": 1000,
      "unit": "mm",
      "quote": "Design choice",
      "note": "One meter, so charge equals charge per meter"
     }
    },
    "assembly": {
     "problem": {
      "physics": "electrostatics",
      "units": "millimeters",
      "type": "planar",
      "depth": "$depth_mm"
     },
     "steps": [
      {
       "use": "material",
       "name": "air",
       "values": {
        "ex": 1,
        "ey": 1
       }
      },
      {
       "use": "conductor",
       "name": "plus",
       "value": "$voltage_V"
      },
      {
       "use": "conductor",
       "name": "minus",
       "value": "=-voltage_V"
      },
      {
       "use": "circle",
       "radius": "$wire_radius_mm",
       "center": [
        "=-center_distance_mm/2",
        0
       ],
       "conductor": "plus"
      },
      {
       "use": "circle",
       "radius": "$wire_radius_mm",
       "center": [
        "=center_distance_mm/2",
        0
       ],
       "conductor": "minus"
      },
      {
       "use": "hole",
       "at": [
        "=-center_distance_mm/2",
        0
       ]
      },
      {
       "use": "hole",
       "at": [
        "=center_distance_mm/2",
        0
       ]
      },
      {
       "use": "block_label",
       "at": [
        0,
        "=boundary_radius_mm/2"
       ],
       "material": "air",
       "mesh": "$air_mesh_mm"
      },
      {
       "use": "iabc_open_boundary",
       "radius": "$boundary_radius_mm"
      }
     ]
    }
   }
  },
  {
   "id": "design-cylindrical-heat-shell",
   "title": "Heat conduction through a cylindrical shell",
   "source_ids": [
    "heatflowtutorial",
    "femm-qt-source-06oct2026",
    "manual5"
   ],
   "source_url": null,
   "purpose": "Fixed-temperature conductors on circles with an official library material, in heat flow.",
   "measurements": [
    {
     "id": "hot",
     "op": "conductor",
     "name": "hot"
    }
   ],
   "metrics": [
    {
     "name": "heat_flow_W",
     "value": [
      "hot",
      1
     ],
     "part": "abs",
     "unit": "W"
    }
   ],
   "targets": [
    {
     "metric": "heat_flow_W",
     "value": 3172.652099279035,
     "relative_tolerance": 0.01,
     "kind": "analytic",
     "quote": "Q = 2*pi*k*L*(T1-T2)/ln(b/a)",
     "used_for_acceptance": true,
     "note": "Magnitude: the sign follows FEMM's conductor flux convention."
    }
   ],
   "article": {
    "parameters": {
     "inner_radius_m": {
      "value": 0.5,
      "unit": "m",
      "quote": "Design choice",
      "note": "Inner radius"
     },
     "outer_radius_m": {
      "value": 1.0,
      "unit": "m",
      "quote": "Design choice",
      "note": "Outer radius"
     },
     "material": {
      "value": "Brick, Common",
      "unit": "library material",
      "quote": "Design choice",
      "note": "k = 0.7 W/(m K) from heatlib.dat"
     },
     "hot_temperature_K": {
      "value": 800,
      "unit": "K",
      "quote": "Design choice",
      "note": "Inner surface"
     },
     "cold_temperature_K": {
      "value": 300,
      "unit": "K",
      "quote": "Design choice",
      "note": "Outer surface"
     },
     "depth_m": {
      "value": 1,
      "unit": "m",
      "quote": "Design choice",
      "note": "Length"
     },
     "mesh_m": {
      "value": 0.02,
      "unit": "m",
      "quote": "Design choice",
      "note": "Element size"
     }
    },
    "assembly": {
     "problem": {
      "physics": "heatflow",
      "units": "meters",
      "type": "planar",
      "depth": "$depth_m",
      "prev_soln": "",
      "dt": 0
     },
     "steps": [
      {
       "use": "library_material",
       "name": "$material",
       "library": "heatlib.dat"
      },
      {
       "use": "conductor",
       "name": "hot",
       "value": "$hot_temperature_K"
      },
      {
       "use": "conductor",
       "name": "cold",
       "value": "$cold_temperature_K"
      },
      {
       "use": "circle",
       "radius": "$inner_radius_m",
       "conductor": "hot"
      },
      {
       "use": "circle",
       "radius": "$outer_radius_m",
       "conductor": "cold"
      },
      {
       "use": "hole",
       "at": [
        0,
        0
       ]
      },
      {
       "use": "block_label",
       "at": [
        0,
        "=(inner_radius_m+outer_radius_m)/2"
       ],
       "material": "$material",
       "mesh": "$mesh_m"
      }
     ]
    }
   }
  },
