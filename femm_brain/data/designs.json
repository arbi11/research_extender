       "mesh": "$mesh_size_cm"
      },
      {
       "use": "block_label",
       "at": [
        0,
        "=(stator_radius_cm+domain_radius_cm)/2"
       ],
       "material": "Air",
       "mesh": "$mesh_size_cm"
      }
