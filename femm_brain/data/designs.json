   ],
   "targets": [
    {
     "metric": "heat_flow_W",
     "value": 3172.652099279035,
     "relative_tolerance": 0.01,
     "kind": "analytic",
     "quote": "Q = 2*pi*k*L*(T1-T2)/ln(b/a)",
     "used_for_acceptance": true,
     "note": "Magnitude: the sign follows FEMM's conductor flux convention."
    }
   ],
   "article": {
    "parameters": {
     "inner_radius_m": {
      "value": 0.5,
      "unit": "m",
      "quote": "Design choice",
      "note": "Inner radius"
     },
     "outer_radius_m": {
      "value": 1.0,
      "unit": "m",
      "quote": "Design choice",
      "note": "Outer radius"
     },
     "material": {
      "value": "Brick, Common",
      "unit": "library material",
      "quote": "Design choice",
      "note": "k = 0.7 W/(m K) from heatlib.dat"
     },
     "hot_temperature_K": {
      "value": 800,
      "unit": "K",
      "quote": "Design choice",
      "note": "Inner surface"
     },
     "cold_temperature_K": {
      "value": 300,
      "unit": "K",
      "quote": "Design choice",
      "note": "Outer surface"
     },
     "depth_m": {
      "value": 1,
      "unit": "m",
      "quote": "Design choice",
      "note": "Length"
     },
     "mesh_m": {
      "value": 0.02,
      "unit": "m",
      "quote": "Design choice",
      "note": "Element size"
     }
    },
    "assembly": {
     "problem": {
      "physics": "heatflow",
      "units": "meters",
      "type": "planar",
      "depth": "$depth_m",
      "prev_soln": "",
      "dt": 0
     },
     "steps": [
      {
       "use": "library_material",
       "name": "$material",
       "library": "heatlib.dat"
      },
      {
       "use": "conductor",
       "name": "hot",
       "value": "$hot_temperature_K"
      },
      {
       "use": "conductor",
       "name": "cold",
       "value": "$cold_temperature_K"
      },
      {
       "use": "circle",
       "radius": "$inner_radius_m",
       "conductor": "hot"
      },
      {
       "use": "circle",
       "radius": "$outer_radius_m",
       "conductor": "cold"
      },
      {
       "use": "hole",
       "at": [
        0,
        0
       ]
      },
      {
       "use": "block_label",
       "at": [
        0,
        "=(inner_radius_m+outer_radius_m)/2"
       ],
       "material": "$material",
       "mesh": "$mesh_m"
      }
     ]
    }
   }
  },
