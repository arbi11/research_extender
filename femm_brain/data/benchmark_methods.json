{
  "schema_version": 1,
  "nodes": [
    {
      "id": "method:benchmark_source_reconstruction",
      "layer": 2,
      "kind": "method",
      "title": "Reconstruct complete passive native source data",
      "description": "Read the curated native model as geometry and physical data, then emit allowlisted native FEMM calls. Retain source units, depth, connectivity, circular arcs, material coefficients and B-H points, circuits, signed winding turns and every boundary attachment. Compare the saved native model with the intended source assignments before mesh and solve.",
      "parameters": [],
      "inputs": [
        "Hash-bound passive native source model",
        "Supported editable current and mesh parameters"
      ],
      "outputs": [
        "Generated editable Lua and native FEMM model",
        "Independent saved-physics assignment verification"
      ],
      "constraints": [
        "Downloaded code is not executed.",
        "Unsupported source properties must fail explicitly rather than being omitted.",
        "Changing currents or mesh does not permit altering source geometry or constitutive data."
      ],
      "capabilities": [
        "source_model_reconstruction",
        "numerical_reference_checks"
      ],
      "source_ids": [
        "inductanceexample",
        "acforceexample",
        "radialmagneticbearing",
        "manual5"
      ],
      "tags": [
        "documented_benchmark",
        "source_reconstruction"
      ],
      "verification": {
        "status": "documented",
        "note": "Source-backed method and predeclared checks. Numerical verification belongs to each generated run report; this graph record does not assert that all source studies were reproduced."
      }
    },
    {
      "id": "method:benchmark_ei_output_checks",
      "layer": 2,
      "kind": "method",
      "title": "EI core: linkage, energy and actuator force checks",
      "description": "Compare linkage inductance with the published 1.73 mH result, all-domain magnetic energy with 0.000865042 J and upward weighted-stress force on the lower I-return with 1.11347 N. For this linear finite A=0 model, cross-check L=psi/I and L=2W/I\u00b2, retain force direction and inspect transverse force.",
      "parameters": [],
      "inputs": [
        "Solved exact source EI model at 1 A DC",
        "All-domain energy selection",
        "Lower I-return body selection at (0,-0.125) in"
      ],
      "outputs": [
        "Published-output comparisons for L,W,Fy",
        "Linkage-energy agreement and force direction checks"
      ],
      "constraints": [
        "The 1.39 mH circuit approximation is a sanity check, not the numerical reproduction target.",
        "Strict published values apply only to source geometry, materials and matching excitation.",
        "Current reversal preserves L,W,F; linear doubling of current gives 4 times W and F."
      ],
      "capabilities": [
        "source_model_reconstruction",
        "numerical_reference_checks"
      ],
      "source_ids": [
        "inductanceexample",
        "acforceexample",
        "manual5"
      ],
      "tags": [
        "documented_benchmark",
        "source_reconstruction"
      ],
      "verification": {
        "status": "documented",
        "note": "Source-backed method and predeclared checks. Numerical verification belongs to each generated run report; this graph record does not assert that all source studies were reproduced."
      },
      "source_model_sha256": "cea7acd3ed0296ea4531f7d8b6693adfa87683dd5c6857f4d76231042963cabb",
      "published_targets": [
        {
          "metric": "inductance_mH",
          "value": 1.73,
          "unit": "mH",
          "relative_tolerance": 0.01,
          "source_id": "inductanceexample"
        },
        {
          "metric": "energy_J",
          "value": 0.000865042,
          "unit": "J",
          "relative_tolerance": 0.01,
          "source_id": "inductanceexample"
        },
        {
          "metric": "force_y_N",
          "value": 1.11347,
          "unit": "N",
          "relative_tolerance": 0.01,
          "source_id": "acforceexample"
        }
      ]
    },
    {
      "id": "method:benchmark_bearing_output_checks",
      "layer": 2,
      "kind": "method",
      "title": "Eight-pole bearing: nonlinear rotor-force checks",
      "description": "Retain the source 13-point M19 B-H curve and source 6/12/6/0 A quadrant currents, then compare upward rotor weighted-stress force with the rounded published 400 N result. Inspect transverse force and saturation; global current reversal must preserve force, while nonlinear current scaling has no exact quadratic force law.",
      "parameters": [],
      "inputs": [
        "Exact nonlinear source bearing model",
        "Rotor iron selection at (0.287013,0.69291) in"
      ],
      "outputs": [
        "Published rounded 400 N rotor force comparison",
        "Force direction, symmetry and nonlinear-excitation diagnostics"
      ],
      "constraints": [
        "The preliminary 460 N circuit estimate is not the finite-element reproduction target.",
        "Native depth 1.6 in and LamFill 1 differ from nominal prose 4 cm and 0.98 packing; preserve and disclose native values.",
        "Reported upper-leg 1.59 T and airgap 1.1 T lack unique point coordinates and are diagnostic references, not strict pointwise targets.",
        "A static field study does not establish bearing control stability or rotor dynamics."
      ],
      "capabilities": [
        "source_model_reconstruction",
        "numerical_reference_checks"
      ],
      "source_ids": [
        "radialmagneticbearing",
        "manual5"
      ],
      "tags": [
        "documented_benchmark",
        "source_reconstruction"
      ],
      "verification": {
        "status": "documented",
        "note": "Source-backed method and predeclared checks. Numerical verification belongs to each generated run report; this graph record does not assert that all source studies were reproduced."
      },
      "source_model_sha256": "85069a0505f8e430f345ea74271def0f8f322f78db8dd9fa8d11a46c3413851e",
      "published_targets": [
        {
          "metric": "force_y_N",
          "value": 400,
          "unit": "N",
          "relative_tolerance": 0.05,
          "source_id": "radialmagneticbearing",
          "precision": "rounded narrative reference"
        }
      ]
    }
  ],
