  "assembly": {
   "problem": {
    "physics": "magnetics",
    "units": "millimeters",
    "type": "planar",
    "frequency": 0,
    "depth": "$active_length_mm",
    "ac_solver": 0
   },
   "steps": [
    {
     "use": "library_material",
     "name": "Air",
     "library": "matlib.dat"
    },
    {
     "use": "library_material",
     "name": "Copper",
     "library": "matlib.dat"
    },
    {
     "use": "library_material",
     "name": "$steel_grade",
     "library": "matlib.dat",
     "as_name": "Steel"
    },
    {
     "use": "material",
     "name": "Magnet",
     "values": {
      "Mu_x": "$magnet_mu_r",
      "Mu_y": "$magnet_mu_r",
      "H_c": "$magnet_coercivity_A_per_m"
     }
    },
    {
     "use": "material",
     "name": "Hub",
     "values": {
      "Mu_x": "$hub_mu_r",
      "Mu_y": "$hub_mu_r"
     }
    },
    {
     "use": "circuit",
     "name": "A",
     "current": 0
    },
    {
     "use": "circuit",
     "name": "B",
     "current": 0
    },
    {
     "use": "circuit",
     "name": "C",
     "current": 0
    },
    {
     "use": "fixed_potential_boundary",
     "name": "A=0",
     "value": 0
    },
    {
     "use": "trapezoidal_slot_stator",
     "slot_count": "$slots",
     "bore_radius": "$bore_radius_mm",
     "opening_width": "$opening_width_mm",
     "opening_height": "$opening_height_mm",
     "slot_width_top": "$slot_width_gap_end_mm",
     "slot_width_bottom": "$slot_width_yoke_end_mm",
     "slot_height": "$slot_height_mm",
     "rotor_side": "inner",
     "slot_bottom": "flat",
     "bore_max_segment": "$bore_max_segment_deg",
     "iron_material": "Steel",
     "iron_mesh": "$iron_mesh_mm"
    },
    {
     "use": "circle",
     "radius": "$outer_radius_mm",
     "max_segment": 1,
     "boundary": "A=0"
    },
    {
     "use": "tooth_coil_winding",
     "slot_count": "$slots",
     "pole_pairs": "$pole_pairs",
     "turns": "$turns_per_coil",
     "material": "Copper",
     "label_radius": "$coil_label_radius_mm",
     "layers": "single",
     "phase_sequence": "forward",
     "mesh": "$slot_mesh_mm"
    },
    {
     "use": "block_label",
     "at": [
      "$gap_label_radius_mm",
      0
     ],
     "material": "Air",
     "mesh": "$gap_mesh_mm"
    },
    {
     "use": "surface_magnet_rotor",
     "pole_count": "$poles",
     "magnet_material": "Magnet",
     "thickness": "$magnet_depth_mm",
     "magnet_shape": "arc",
     "inner_radius": "$rotor_core_outer_radius_mm",
     "arc_angle": "$magnet_span_deg",
     "air_gap_side": "outer",
     "magnetization": "parallel",
     "first_pole_polarity": "outward",
     "mesh": "$magnet_mesh_mm",
     "arc_max_segment": "$magnet_arc_max_segment_deg",
     "seat_arcs": true,
     "group": 1
    },
    {
     "use": "circle",
     "radius": "$rotor_inner_radius_mm",
     "max_segment": 2,
     "group": 1
    },
    {
     "use": "block_label",
     "at": [
      "$rotor_label_radius_mm",
      0
     ],
     "material": "Steel",
     "mesh": "$iron_mesh_mm",
     "group": 1
    },
    {
     "use": "block_label",
     "at": [
      0,
      0
     ],
     "material": "Hub",
     "mesh": "$hub_mesh_mm",
     "group": 1
    }
   ]
  }
 },
 "gaps": [
  {
   "item": "lamination steel grade",
   "affects": "flux linkage and inductance, little while the iron is unsaturated",
   "decision": "assumed",
   "note": "M-19 14 mil from the FEMM library; control steel-m19-solid."
  },
  {
   "item": "rotor hub material",
   "affects": "rotor yoke flux, negligible with a 25 mm yoke",
   "decision": "assumed",
   "note": "Non-magnetic; control hub-steel."
  },
  {
   "item": "how the FEA inductance was computed",
   "affects": "the 2D inductance target",
   "decision": "assumed",
   "note": "Phase A alone at rated peak current with the magnets inactive (mutual inductance is about zero per Table III); a tenth of rated current is measured too."
  },
  {
   "item": "tooth width 11.4 mm against the slot widths",
   "affects": "slot area, slot leakage and so inductance",
   "decision": "resolved",
   "note": "The slot widths are used: they imply parallel 8.3-8.4 mm teeth, match Fig. 1, and reproduce the 12.6 kg iron mass of Table V; control tooth-width-11p4."
  },
  {
   "item": "which slot end each width belongs to",
   "affects": "slot leakage",
   "decision": "resolved",
   "note": "From Fig. 1; control slot-widths-swapped."
  },
  {
   "item": "tapered magnet edges of the built rotor (Fig. 23)",
   "affects": "back-EMF harmonics",
   "decision": "out_of_scope",
   "note": "The analytical model's radial-sided arcs (Fig. 22) are built, as the paper's analytical and FEA results use."
  },
  {
   "item": "slot bottom and corner shape",
   "affects": "slot area, slightly",
   "decision": "figure",
   "note": "Flat bottoms and straight sides, as Fig. 1 shows."
  }
 ],
