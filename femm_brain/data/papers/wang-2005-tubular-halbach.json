  "assembly": {
   "problem": {
    "physics": "magnetics",
    "units": "millimeters",
    "type": "axisymmetric",
    "frequency": 0,
    "depth": 1
   },
   "steps": [
    {
     "use": "material",
     "name": "Air"
    },
    {
     "use": "material",
     "name": "Magnet",
     "values": {
      "Mu_x": "$mu_r",
      "Mu_y": "$mu_r",
      "H_c": "$magnet_coercivity_A_per_m"
     }
    },
    {
     "use": "boundary",
     "name": "periodic magnets",
     "values": {
      "BdryType": 4
     }
    },
    {
     "use": "boundary",
     "name": "periodic air",
     "values": {
      "BdryType": 4
     }
    },
    {
     "use": "magnet_array",
     "start": 0,
     "inner": "$r0_mm",
     "outer": "$rm_mm",
     "axis": "y",
     "magnet_material": "Magnet",
     "mesh": "$magnet_mesh_mm",
     "segments": [
      [
       "=tau_mz_mm/2",
       "$axial_plus_deg"
      ],
      [
       "$tau_mr_mm",
       "$radial_out_deg"
      ],
      [
       "$tau_mz_mm",
       "=axial_plus_deg+180"
      ],
      [
       "$tau_mr_mm",
       "=radial_out_deg+180"
      ],
      [
       "=tau_mz_mm/2",
       "$axial_plus_deg"
      ]
     ]
    },
    {
     "use": "polyline",
     "points": [
      [
       "$rm_mm",
       0
      ],
      [
       "$rs_mm",
       0
      ],
      [
       "$rs_mm",
       "$period_mm"
      ],
      [
       "$rm_mm",
       "$period_mm"
      ]
     ],
     "closed": false,
     "edges": [
      {
       "boundary": "periodic air"
      },
      {},
      {
       "boundary": "periodic air"
      }
     ]
    },
    {
     "use": "segment_boundary",
     "name": "periodic magnets",
     "at": [
      [
       "=(r0_mm+rm_mm)/2",
       0
      ],
      [
       "=(r0_mm+rm_mm)/2",
       "$period_mm"
      ]
     ]
    },
    {
     "use": "block_label",
     "at": [
      "=(rm_mm+rs_mm)/2",
      "=period_mm/2"
     ],
     "material": "Air",
     "mesh": "$gap_mesh_mm"
    },
    {
     "use": "fixed_point_potential",
     "at": [
      "$r0_mm",
      "=tau_mz_mm/2"
     ],
     "name": "gauge"
    }
   ]
  }
 },
