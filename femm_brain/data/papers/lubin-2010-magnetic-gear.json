  "assembly": {
   "problem": {
    "physics": "magnetics",
    "units": "millimeters",
    "type": "planar",
    "frequency": 0,
    "depth": "$axial_length_mm"
   },
   "steps": [
    {
     "use": "material",
     "name": "Air"
    },
    {
     "use": "material",
     "name": "Magnet",
     "values": {
      "Mu_x": "$magnet_mu_r",
      "Mu_y": "$magnet_mu_r",
      "H_c": "$magnet_coercivity_A_per_m"
     }
    },
    {
     "use": "ring_sectors",
     "inner_radius": "$r5_mm",
     "outer_radius": "$r6_mm",
     "copies": "$outer_pole_pairs",
     "angle_step": "=360/outer_pole_pairs",
     "sectors": [
      [
       0,
       "=180/outer_pole_pairs",
       "Magnet",
       "outward"
      ],
      [
       "=180/outer_pole_pairs",
       "=360/outer_pole_pairs",
       "Magnet",
       "inward"
      ]
     ],
     "max_segment": "$ring_arc_deg",
     "mesh": "$magnet_mesh_mm"
    },
    {
     "use": "air_gap_element",
     "rotor_radius": "=r4_mm+band_margin_mm",
     "stator_radius": "=r5_mm-band_margin_mm",
     "max_segment": "$gap_arc_deg",
     "name": "AGE_out"
    },
    {
     "use": "ring_sectors",
     "inner_radius": "$r3_mm",
     "outer_radius": "$r4_mm",
     "copies": "$pole_pieces",
     "angle_step": "=360/pole_pieces",
     "sectors": [
      [
       "=slot_opening_deg/2",
       "=360/pole_pieces-slot_opening_deg/2",
       null,
       null
      ]
     ],
     "gap_material": "Air",
     "max_segment": "$gap_arc_deg",
     "gap_mesh": "$slot_air_mesh_mm"
    },
    {
     "use": "air_gap_element",
     "rotor_radius": "=r2_mm+band_margin_mm",
     "stator_radius": "=r3_mm-band_margin_mm",
     "max_segment": "$gap_arc_deg",
     "name": "AGE_in"
    },
    {
     "use": "ring_sectors",
     "inner_radius": "$r1_mm",
     "outer_radius": "$r2_mm",
     "copies": "$inner_pole_pairs",
     "angle_step": "=360/inner_pole_pairs",
     "sectors": [
      [
       0,
       "=180/inner_pole_pairs",
       "Magnet",
       "outward"
      ],
      [
       "=180/inner_pole_pairs",
       "=360/inner_pole_pairs",
       "Magnet",
       "inward"
      ]
     ],
     "max_segment": "$ring_arc_deg",
     "mesh": "$magnet_mesh_mm"
    },
    {
     "use": "hole",
     "at": [
      0,
      0
     ]
    },
    {
     "use": "block_label",
     "at": [
      "=r5_mm-band_margin_mm/2",
      0.0
     ],
     "material": "Air",
     "mesh": "$thin_air_mesh_mm"
    },
    {
     "use": "block_label",
     "at": [
      "=r4_mm+band_margin_mm/2",
      0.0
     ],
     "material": "Air",
     "mesh": "$thin_air_mesh_mm"
    },
    {
     "use": "block_label",
     "at": [
      "=r3_mm-band_margin_mm/2",
      0.0
     ],
     "material": "Air",
     "mesh": "$thin_air_mesh_mm"
    },
    {
     "use": "block_label",
     "at": [
      "=r2_mm+band_margin_mm/2",
      0.0
     ],
     "material": "Air",
     "mesh": "$thin_air_mesh_mm"
    },
    {
     "use": "fixed_point_potential",
     "at": [
      "$r6_mm",
      0
     ],
     "name": "A0"
    }
   ]
  }
 },
 "variants": [
  {
   "id": "example-2",
   "purpose": "Application example 2 (Section V): 3 inner and 13 outer pole pairs, 16 pole pieces, slot opening pi/16; Fig. 17's sweep of 60 degrees in steps of 60/57 degrees.",
   "parameters": {
    "inner_pole_pairs": 3,
    "outer_pole_pairs": 13,
    "pole_pieces": 16,
    "slot_opening_fraction_of_pi": 0.0625,
    "sweep_step_deg": 1.0526315789473684
   }
  }
 ],
 "gaps": [
  {
   "item": "the torque's sign convention",
   "affects": "torque targets",
   "decision": "resolved",
   "note": "Not defined; Fig. 12's torque is positive between 0 and 90 degrees. Magnitudes are compared (the curve does not change sign inside the range)."
  },
  {
   "item": "which rotor has 13 pole pairs in Example 2",
   "affects": "the variant",
   "decision": "resolved",
   "note": "The text says po = 3 and pi = 13, but the inner air-gap field of Fig. 15 has 3 periods and the outer of Fig. 16 about 13, and Fig. 17 sweeps the inner rotor over 60 degrees, half a period only for 3 pole pairs. The variant has 3 inner and 13 outer pole pairs."
  },
  {
   "item": "the coupled rotation of Figs. 13 and 18, and the field plots",
   "affects": "comparators only",
   "decision": "out_of_scope",
   "note": "The sweep assessor samples a sweep that starts at zero; the coupled sweep starts at 40 degrees. The field plots are not digitized."
  }
 ],
